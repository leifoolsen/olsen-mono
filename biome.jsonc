{
  "$schema": "https://biomejs.dev",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.d.ts",
      "!**/node_modules",
      "!**/dist",
      "!tools/css-to-dts/src/__tests__/__fixtures__/**/*",
      "!**/CHANGELOG.md"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  // Disables formatting until Biome's formatter fully supports Astro and MD markup
  "overrides": [
    {
      "includes": ["**/*.astro", "**/*.md", "**/*.mdx"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ]
}
