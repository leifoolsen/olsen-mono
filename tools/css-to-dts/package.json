{
  "name": "@olsen-mono/css-to-dts",
  "description": "CLI tool used to generate TypeScript Declaration files (.d.ts) from CSS files.",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "main": "./dist/css-to-dts.mjs",
  "bin": {
    "css-to-dts": "./dist/css-to-dts.mjs"
  },
  "exports": {
    ".": "./dist/css-to-dts.mjs",
    "./package.json": "./package.json"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "leif.o.olsen@gmail.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/olsen-mono/olsen-mono.git",
    "directory": "tools/css-to-dts"
  },
  "bugs": {
    "url": "https://github.com/olsen-mono/olsen-mono/issues"
  },
  "homepage": "https://github.com/olsen-mono/olsen-mono#readme",
  "scripts": {
    "compile": "tsdown --clean",
    "lint": "biome check . --no-errors-on-unmatched && prettier --ignore-path ../../.prettierignore --check \"*.+(astro|md|mdx)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
