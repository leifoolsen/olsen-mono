{
  "$schema": "https://turbo.build",
  "globalDependencies": ["vitest.config.ts", "tsconfig.json", "tools/tooling/**/*"],
  "tasks": {
    "//#lint-biome": {},
    "//#lint-fix-biome": {
      "cache": false
    },
    "//#lint-prettier": {},
    "//#lint-fix-prettier": {
      "cache": false
    },
    "compile": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**", "src/**/*.css.d.ts"]
    },
    "typecheck-astro": {
      "dependsOn": ["^compile", "compile"],
      "outputs": [".astro/**"]
    },
    "typecheck-tsc": {
      "dependsOn": ["^compile", "compile"]
    },
    "test": {
      "dependsOn": ["^compile", "compile"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.astro", "src/**/*.css", "!src/**/*.css.d.ts"]
    },
    "test-coverage": {
      "dependsOn": ["^compile", "compile"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.astro", "src/**/*.css", "!src/**/*.css.d.ts"]
    },
    "build": {
      "dependsOn": [
        "^compile",
        "compile",
        "//#lint-biome",
        "//#lint-prettier",
        "typecheck-tsc",
        "typecheck-astro",
        "test"
      ],
      "outputs": [".astro/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
