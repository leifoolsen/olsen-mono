{
  "$schema": "https://turbo.build",
  "globalDependencies": [
    ".gitignore",
    "tsconfig.json",
    "biome.jsonc",
    "pnpm-workspace.yaml",
    "vitest.workspace.ts",
    "tools/tooling/**/*",
    "!.turbo/**",
    "**/dist/**",
    "!**/.coverage/**"
  ],
  "tasks": {
    "compile": {
      "dependsOn": ["^compile"],
      "inputs": [
        "src/**/*.css",
        "src/**/*.ts",
        "src/**/*.tsx",
        "!src/**/*.d.ts",
        "src/**/*.astro",
        "src/**/*.svg",
        "tsconfig.json"
      ],
      "outputs": ["dist/", "src/**/*.css.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.astro", "src/**/*.svg", "tsconfig.json"]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.astro",
        "tsconfig.json",
        "astro.config.mjs",
        "!src/**/*.d.ts",
        "!src/**/*.css.d.ts",
        "**/dist/**"
      ]
    },
    "test": {
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.astro",
        "src/**/*.css",
        "!src/**/*.css.d.ts",
        "**/__tests__/**/*",
        "vitest.config.ts",
        "../../vitest.workspace.ts",
        "**/dist/**",
        "!**/.coverage/**",
        "!**/.vitest-cache/**"
      ]
    },
    "test-coverage": {
      "dependsOn": ["compile"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
