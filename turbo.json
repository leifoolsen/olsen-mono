{
  "$schema": "https://turbo.build",
  "globalDependencies": [],
  "tasks": {
    "//#lint-biome": {
      "inputs": ["biome.json", "apps/**/*", "packages/**/*"]
    },
    "//#lint-fix-biome": {
      "cache": false
    },
    "//#lint-prettier": {
      "inputs": [
        "**/*.md",
        "**/*.astro",
        ".prettierrc.mjs",
        "!**/CHANGELOG.md",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.astro/**"
      ]
    },
    "//#lint-fix-prettier": {
      "cache": false
    },
    "compile": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**", "src/**/*.css.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["^compile", "compile"]
    },
    "test": {
      "dependsOn": ["compile"]
    },
    "test-coverage": {
      "dependsOn": ["compile"]
    },
    "build": {
      "dependsOn": ["^compile", "compile"],
      "outputs": [".astro/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
