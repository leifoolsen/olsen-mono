{
  "$schema": "https://turbo.build",
  "globalDependencies": [".gitignore", "tsconfig.json", "biome.jsonc", "pnpm-workspace.yaml"],
  "tasks": {
    "compile": {
      "dependsOn": ["^compile"],
      "inputs": ["src/**/*.css", "src/**/*.ts", "src/**/*.tsx", "!src/**/*.d.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^compile"],
      "cache": true,
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"]
    },
    "lint": {
      "cache": true,
      "inputs": ["src/**/*", "**/*.astro", "**/*.json", "*.mjs", "*.js"]
    },
    "test": {
      "cache": true,
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "test/**/*.ts", "test/**/*.tsx"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
