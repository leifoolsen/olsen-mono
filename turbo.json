{
  "$schema": "https://turbo.build",
  "globalDependencies": [],
  "tasks": {
    "//#lint-biome": {},
    "//#lint-fix-biome": {
      "cache": false
    },
    "//#lint-prettier": {},
    "//#lint-fix-prettier": {
      "cache": false
    },
    "compile": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**", "src/**/*.css.d.ts"]
    },
    "typecheck-astro": {
      "dependsOn": ["^compile", "compile"],
      "outputs": [".astro/**"]
    },
    "typecheck-tsc": {
      "dependsOn": ["^compile", "compile"]
    },
    "test": {
      "dependsOn": ["compile"]
    },
    "test-coverage": {
      "dependsOn": ["compile"]
    },
    "build": {
      "dependsOn": ["^compile", "compile", "//#lint-biome", "//#lint-prettier"],
      "outputs": [".astro/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
