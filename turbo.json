{
  "$schema": "https://turbo.build",
  "globalDependencies": [
    ".gitignore",
    "tsconfig.json",
    "biome.jsonc",
    "pnpm-workspace.yaml",
    "vitest.workspace.ts",
    "tools/tooling/**/*"
  ],
  "tasks": {
    "compile": {
      "dependsOn": ["^compile"],
      "inputs": [
        "src/**/*.css",
        "src/**/*.ts",
        "src/**/*.tsx",
        "!src/**/*.d.ts",
        "src/**/*.astro",
        "src/**/*.svg",
        "tsconfig.json"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.astro", "src/**/*.svg", "tsconfig.json"]
    },
    "lint": {
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["src/**/*", "**/*.astro", "**/*.json", "*.mjs", "*.js"]
    },
    "test": {
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["src/**/*", "**/__tests__/**/*", "vitest.config.ts", "../../vitest.workspace.ts"]
    },
    "test-coverage": {
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["src/**/*", "**/__tests__/**/*", "vitest.config.ts", "../../vitest.workspace.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    }
  }
}
