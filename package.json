{
  "name": "olsen-mono",
  "description": "A monorepo for exploring stuff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "astro",
    "biome",
    "css-to-dts",
    "htmx",
    "monorepo",
    "node 26",
    "pnpm",
    "tsdown",
    "turborepo",
    "typescript 6",
    "vite",
    "vitest"
  ],
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "node": {
      "version": "26.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "author": "Leif Olsen",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olsen-mono/olsen-mono.git"
  },
  "bugs": {
    "url": "https://github.com/olsen-mono/olsen-mono/issues"
  },
  "homepage": "https://github.com/olsen-mono/olsen-mono#readme",
  "scripts": {
    "build": "turbo //#lint-biome //#lint-prettier compile typecheck test build",
    "changeset": "changeset",
    "changeset-dry": "changeset status --verbose",
    "ci": "pnpm build",
    "clean": "shx rm -rf .turbo \"**/.turbo\" node_modules/.cache \"**/node_modules/.vite\" \"**/.tsbuildinfo\" && pnpm install",
    "compile": "turbo compile",
    "find-caches": "shx ls -d .turbo \"**/.turbo\" \"**/node_modules/.vite\" \"node_modules/.cache\" \"**/.tsbuildinfo\"",
    "lint": "turbo //#lint-biome //#lint-prettier",
    "lint-biome": "biome check --files-ignore-unknown=true",
    "lint-prettier": "prettier --no-error-on-unmatched-pattern --check \"*.{astro,md}\"",
    "lint-fix": "turbo //#lint-fix-biome //#lint-fix-prettier",
    "lint-fix-biome": "biome check --write --no-errors-on-unmatched",
    "lint-fix-prettier": "prettier --no-error-on-unmatched-pattern --check \"*.{astro,md}\" --write",
    "prepare": "pnpm --filter=@olsen-mono/css-to-dts run compile",
    "release": "pnpm compile && changeset publish",
    "show-tsconfig": "tsc --showConfig",
    "test": "turbo test",
    "test-coverage": "turbo test-coverage",
    "test-watch": "vitest",
    "typecheck": "turbo typecheck",
    "version-packages": "changeset version && pnpm install",
    "watch-css": "pnpm -r --parallel --if-present watch-css",
    "dev-ds": "pnpm --filter=./apps/astro-design-system... dev"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "1.10.12",
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "3.0.3",
    "@olsen-mono/tooling": "workspace:*",
    "@tsdown/css": "0.23.2",
    "@turbo/gen": "2.11.10",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "10.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "shx": "0.4.0",
    "tsdown": "0.23.2",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
