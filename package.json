{
  "name": "olsen-mono",
  "description": "A monorepo for exploring stuff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "astro",
    "biome",
    "css-to-dts",
    "htmx",
    "monorepo",
    "node 26",
    "pnpm",
    "tsdown",
    "turborepo",
    "typescript 6",
    "vite",
    "vitest"
  ],
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "node": {
      "version": "26.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "author": "Leif Olsen",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olsen-mono/olsen-mono.git"
  },
  "bugs": {
    "url": "https://github.com/olsen-mono/olsen-mono/issues"
  },
  "homepage": "https://github.com/olsen-mono/olsen-mono#readme",
  "scripts": {
    "build": "turbo run compile typecheck lint test",
    "changeset": "changeset",
    "changeset-dry": "changeset status --verbose",
    "ci": "pnpm build",
    "clean": "shx rm -rf .turbo \"**/.turbo\" node_modules/.cache \"**/node_modules/.vite\" \"**/.tsbuildinfo\" && pnpm install",
    "compile": "turbo run compile",
    "find-caches": "shx ls -d .turbo \"**/.turbo\" \"**/node_modules/.vite\" \"node_modules/.cache\" \"**/.tsbuildinfo\"",
    "lint": "pnpm lint:root && turbo run lint",
    "lint:root": "prettier --no-error-on-unmatched-pattern --ignore-path .prettierignore --check \"*.{json,md,mjs,ts,yml,yaml}\"",
    "lint-fix-biome": "biome check --no-error-on-unmatched --write .",
    "lint-fix-prettier": "prettier --no-error-on-unmatched-pattern --ignore-path .prettierignore --write \"**/*.+(astro|md|mdx)\"",
    "lint-fix-root": "prettier --no-error-on-unmatched-pattern --ignore-path .prettierignore --write \"*.{json,md,mjs,ts,yml,yaml}\"",
    "prepare": "pnpm --filter=@olsen-mono/css-to-dts run compile",
    "release": "pnpm compile && changeset publish",
    "show-tsconfig": "tsc --showConfig",
    "test": "turbo run test",
    "test-watch": "vitest",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version && pnpm install",
    "watch-css": "pnpm -r --parallel --if-present watch-css",
    "dev-astro": "pnpm --filter=./apps/astro-htmx... dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "3.0.2",
    "@olsen-mono/tooling": "workspace:*",
    "@tsdown/css": "0.23.0",
    "@turbo/gen": "2.10.12",
    "@types/css-modules": "1.0.5",
    "@types/node": "catalog:",
    "cross-env": "10.1.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "shx": "0.4.0",
    "tsdown": "0.23.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
