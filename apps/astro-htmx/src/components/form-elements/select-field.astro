---
// src/components/form-element/select-field.astro

import { assertValidSlots } from '@components/utils/assert-valid-slots.ts';
import type { HTMLAttributes } from 'astro/types';
import FieldHelp from './field-help.astro';
import './form-elements.css';

type Props = HTMLAttributes<'select'> & {
  id: string;
  invalid?: boolean;
  labelPosition?: 'top' | 'before';
};

const {
  class: className,
  id,
  invalid,
  labelPosition = 'top',
  ...rest
} = Astro.props;

// Vi tillater både 'label' og 'default' for maksimal konsistens
const ALLOWED_SLOTS = ['label', 'description', 'error-message'] as const;
assertValidSlots(Astro.slots, ALLOWED_SLOTS, 'SelectField');

const hasDescription = Astro.slots.has('description');
const hasErrorSlot = Astro.slots.has('error-message');

const isInvalid = invalid === true;
const showErrorMessage = isInvalid && hasErrorSlot;

const descriptionId = `${id}-desc`;
const errorId = `${id}-error`;
const uniqueAnchorName = `--anchor-${id}`;

const ariaDescribedBy = [
  hasDescription ? descriptionId : '',
  showErrorMessage ? errorId : ''
].filter(Boolean).join(' ') || undefined;

// Vi sjekker spesifikt etter 'label'-sloten
const hasLabel = Astro.slots.has('label');

const Wrapper = hasLabel ? 'div' : Fragment;
const wrapperProps = hasLabel
  ? { class: `input-group ${labelPosition === 'top' ? 'label-top' : 'label-before'}`.trim() }
  : {};
---
<Wrapper {...wrapperProps}>
  <div
    class="input-container select-container"
    style={hasDescription ? `anchor-name: ${uniqueAnchorName};` : undefined}
  >
    <select
      aria-invalid={isInvalid ? "true" : undefined}
      aria-describedby={ariaDescribedBy}
      class:list={['text-input', 'select-input', className]}
      id={id}
      {...rest}
    >
      {/* Default-sloten brukes til <option>-taggene */}
      <slot />
    </select>

    {hasDescription && (
      <FieldHelp id={id} descriptionId={descriptionId}>
        <slot name="description" />
      </FieldHelp>
    )}
  </div>

  {hasLabel && (
    <label for={id}>
      {/* Vi henter innholdet fra 'label'-sloten */}
      <slot name="label" />
    </label>
  )}

  {hasErrorSlot && (
    <div id={errorId} class="error-message" role="alert">
      <slot name="error-message" />
    </div>
  )}
</Wrapper>
