---
// src/components/form-element/select-field.astro

import { assertValidSlots } from '@components/utils/assert-valid-slots.ts';
import { matchAsync} from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import FieldHelp from './field-help.astro';
import './form-elements.css';

type Props = HTMLAttributes<'select'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'top' | 'before';
};

const {
  class: className,
  id,
  invalid,
  label,
  labelPosition = 'top',
  ...rest
} = Astro.props;

const ALLOWED_SLOTS = ['description', 'error-message', 'label'] as const;
assertValidSlots(Astro.slots, ALLOWED_SLOTS, 'SelectField');

const processedLabel = await matchAsync()
  .on(!!label, () => `<label for="${id}">${label}</label>`)
  .on(Astro.slots.has('label'), async () => {
    const rawLabel = await Astro.slots.render('label');
    const isLabelTag = rawLabel ? /^\s*<label(?=[>\s])/i.test(rawLabel) : false;
    return isLabelTag
      ? rawLabel.replace('<label', `<label for="${id}"`)
      : `<label for="${id}">${rawLabel}</label>`;
  })
  .otherwise(() => null);

const hasDescriptionSlot = Astro.slots.has('description');
const descriptionId = hasDescriptionSlot ?`${id}-description` : undefined;

const hasErrorMessageSlot = Astro.slots.has('error-message');
const showErrorMessage = invalid && hasErrorMessageSlot;

const Wrapper = processedLabel ? 'div' : Fragment;
const wrapperProps = processedLabel
  ? { class: `input-group ${labelPosition === 'top' ? 'label-top' : 'label-before'}`.trim() }
  : {};
---
<Wrapper {...wrapperProps}>
  <div class="input-container select-container">
    <select
      aria-describedby={descriptionId}
      aria-invalid={invalid ? "true" : undefined}
      class:list={['text-input', 'select-input', className]}
      data-select-input
      id={id}
      {...rest}
    >
      {/* Default slot is used for <option> and <optgroup> tags */}
      <slot />
    </select>

    <div class="icon chevron-icon" />

    <button
      aria-label="Clear"
      class="tool-btn icon clear-icon"
      tabindex="-1"
      type="button"
    />

    {hasDescriptionSlot && (
      <FieldHelp id={descriptionId!}>
        <slot name="description" />
      </FieldHelp>
    )}
  </div>

  {!!processedLabel && <Fragment set:html={processedLabel} />}

  {showErrorMessage && (
    <div class="error-message" role="alert">
      <slot name="error-message" />
    </div>
  )}
</Wrapper>

<script>
  function setupSelectFields() {
    const inputs = document.querySelectorAll('[data-select-input]');

    for (const input of inputs) {
      if (!(input instanceof HTMLSelectElement) || input.hasAttribute('data-initialized')) continue;
      input.setAttribute('data-initialized', 'true');

      const wrapper = input.closest('.select-container');
      if (!wrapper) continue;

      const chevronIcon = wrapper.querySelector('.chevron-icon');
      const clearIcon = wrapper.querySelector('.clear-icon');
      const infoIcon = wrapper.querySelector('.info-icon');

      if (chevronIcon) {
        chevronIcon.addEventListener('click', () => {
          if (typeof input.showPicker === 'function') {
            input.showPicker();
          }
          input.focus();
        })
      }

      if (clearIcon) {
        clearIcon.addEventListener('click', () => {
          input.value = '';
          input.focus();
          input.dispatchEvent(new Event('input', { bubbles: true }));
        });
      }

      if (infoIcon) {
        infoIcon.addEventListener('click', () => {
          if(!input.disabled) {
            input.focus();
          }
          else {
            (infoIcon as HTMLButtonElement).disabled = true;
          }
        })
      }
    }
  }

  setupSelectFields();
  document.addEventListener('astro:after-swap', setupSelectFields);
</script>
