---
// src/components/form-element/input-field.astro

import { assertValidSlots } from '@components/utils/assert-valid-slots';
import { matchAsync } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import FieldHelp from './field-help.astro';
import './form-elements.css';

type Props = HTMLAttributes<'input'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'top' | 'before';
};

const {
  'aria-describedby': ariaDescribedBy,
  'aria-invalid': ariaInvalid,
  class: className,
  id,
  invalid,
  label,
  labelPosition = 'top',
  type = 'text',
  ...rest
} = Astro.props;

const ALLOWED_SLOTS = ['description', 'error-message', 'label'] as const;
assertValidSlots(Astro.slots, ALLOWED_SLOTS, 'InputField');

const processedLabel = await matchAsync()
  .on(!!label, () => `<label for="${id}">${label}</label>`)
  .on(Astro.slots.has('label'), async () => {
    const rawLabel = await Astro.slots.render('label');
    const isLabelTag = rawLabel ? /^\s*<label(?=[>\s])/i.test(rawLabel) : false;
    return isLabelTag
      ? rawLabel.replace('<label', `<label for="${id}"`)
      : `<label for="${id}">${rawLabel}</label>`;
  })
  .otherwise(() => null);

const hasDescriptionSlot = Astro.slots.has('description');
const descriptionId = hasDescriptionSlot ? `${id}-description` : undefined;

const hasErrorMessageSlot = Astro.slots.has('error-message');
---
<div class:list={['input-group', labelPosition === 'top' ? 'label-top' : 'label-before', className]}>
  <div class="input-container">
    <input
      aria-describedby={descriptionId ?? ariaDescribedBy ?? undefined}
      aria-invalid={invalid ?? ariaInvalid ?? undefined}
      class='text-input'
      data-text-input
      id={id}
      type={type}
      {...rest}
    />

    {type === 'search' && (
      <div class="icon search-icon" />
    )}

    <button
      aria-label="Clear value"
      class="tool-btn icon clear-icon"
      tabindex="-1"
      type="button"
    />

    {hasDescriptionSlot && (
      <FieldHelp id={descriptionId!}>
        <slot name="description" />
      </FieldHelp>
    )}
  </div>

  {!!processedLabel && <Fragment set:html={processedLabel} />}

  {hasErrorMessageSlot && (
    <div class="error-message" role="alert">
      <slot name="error-message" />
    </div>
  )}
</div>

<script>
  function setupInputFields() {
    const inputs = document.querySelectorAll('[data-text-input]');

    for (const input of inputs) {
      if (!(input instanceof HTMLInputElement) || input.hasAttribute('data-initialized')) continue;

      input.setAttribute('data-initialized', 'true');

      const wrapper = input.closest('.input-container');
      if (!wrapper) continue;

      const searchIcon = wrapper.querySelector<HTMLDivElement>('.search-icon');
      const clearButton = wrapper.querySelector<HTMLButtonElement>('.clear-icon');
      const infoButton = wrapper.querySelector<HTMLButtonElement>('.info-icon');

      if (searchIcon) {
        searchIcon.addEventListener('click', () => {
          input.focus();
        })
      }

      if (clearButton) {
        clearButton.addEventListener('click', () => {
          input.value = '';
          input.focus();
          input.dispatchEvent(new Event('input', { bubbles: true }));
        });
      }

      if (infoButton) {
        infoButton.addEventListener('click', () => {
          if(!input.disabled) {
            input.focus();
          }
          else {
            infoButton.disabled = true;
          }
        })
      }
    }
  }

  setupInputFields();
  document.addEventListener('astro:after-swap', setupInputFields);
</script>
