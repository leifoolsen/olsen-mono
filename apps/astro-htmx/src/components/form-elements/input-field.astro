---
// src/components/form-element/input-field.astro

import { assertValidSlots } from '@components/utils/assert-valid-slots.ts';
import type { HTMLAttributes } from 'astro/types';
import FieldHelp from './field-help.astro';
import './form-elements.css';

type Props = HTMLAttributes<'input'> & {
  id: string;
  invalid?: boolean;
  labelPosition?: 'top' | 'before';
};

const {
  class: className,
  id,
  invalid,
  labelPosition = 'top',
  type = 'text',
  ...rest
} = Astro.props;

const ALLOWED_SLOTS = ['description', 'error-message', 'label'] as const;
assertValidSlots(Astro.slots, ALLOWED_SLOTS, 'InputField');

const hasLabel = Astro.slots.has('label') || Astro.slots.has('default');
const labelSlotName = Astro.slots.has('label') ? 'label' : 'default';

const hasDescription = Astro.slots.has('description');
const descriptionId = hasDescription ?`${id}-description` : undefined;
const hasErrorSlot = Astro.slots.has('error-message');

const Wrapper = hasLabel ? 'div' : Fragment;
const wrapperProps = hasLabel
  ? { class: `input-group ${labelPosition === 'top' ? 'label-top' : 'label-before'}`.trim() }
  : {};
---
<Wrapper {...wrapperProps}>
  <div class="input-container">
    <input
      aria-invalid={invalid ? "true" : undefined}
      aria-describedby={descriptionId}
      class:list={['text-input', className]}
      id={id}
      type={type}
      {...rest}
    />

    {hasDescription && (
      <FieldHelp id={id} descriptionId={descriptionId}>
        <slot name="description" />
      </FieldHelp>
    )}
  </div>

  {hasLabel && (
    <label for={id}>
      <slot name={labelSlotName} />
    </label>
  )}

  {hasErrorSlot && (
    <div class="error-message" role="alert">
      <slot name="error-message" />
    </div>
  )}
</Wrapper>

