---
// src/components/form-element/input-field.astro

import { assertValidSlots } from '@components/utils/assert-valid-slots';
import { matchAsync } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import FieldHelp from './field-help.astro';
import './form-elements.css';

type Props = HTMLAttributes<'input'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'top' | 'before';
};

const {
  class: className,
  id,
  invalid,
  label,
  labelPosition = 'top',
  type = 'text',
  ...rest
} = Astro.props;

const ALLOWED_SLOTS = ['description', 'error-message', 'label'] as const;
assertValidSlots(Astro.slots, ALLOWED_SLOTS, 'InputField');

const processedLabel = await matchAsync()
  .on(!!label, () => `<label for="${id}">${label}</label>`)
  .on(Astro.slots.has('label'), async () => {
    const rawLabel = await Astro.slots.render('label');
    const isLabelTag = rawLabel ? /^\s*<label(?=[>\s])/i.test(rawLabel) : false;
    return isLabelTag
      ? rawLabel.replace('<label', `<label for="${id}"`)
      : `<label for="${id}">${rawLabel}</label>`;
  })
  .otherwise(() => null);

const hasDescriptionSlot = Astro.slots.has('description');
const descriptionId = hasDescriptionSlot ?`${id}-description` : undefined;

const hasErrorMessageSlot = Astro.slots.has('error-message');

const Wrapper = processedLabel ? 'div' : Fragment;
const wrapperProps = processedLabel
  ? { class: `input-group ${labelPosition === 'top' ? 'label-top' : 'label-before'}`.trim() }
  : {};
---
<Wrapper {...wrapperProps}>
  <div class="input-container">
    <input
      aria-invalid={invalid ? "true" : undefined}
      aria-describedby={descriptionId}
      class:list={['text-input', className]}
      id={id}
      type={type}
      {...rest}
    />

    {hasDescriptionSlot && (
      <FieldHelp id={descriptionId!}>
        <slot name="description" />
      </FieldHelp>
    )}
  </div>

  {!!processedLabel && <Fragment set:html={processedLabel} />}

  {hasErrorMessageSlot && (
    <div class="error-message" role="alert">
      <slot name="error-message" />
    </div>
  )}
</Wrapper>

