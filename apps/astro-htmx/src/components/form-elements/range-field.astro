---
// src/components/form-element/range-field.astro

import { assertValidSlots } from '@components/utils/assert-valid-slots.ts';
import { matchAsync } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import './form-elements.css';
import FieldHelp from "@components/form-elements/field-help.astro";

type Props = HTMLAttributes<'input'> & {
  id: string;
  label?: string;
  labelPosition?: 'top' | 'before';
  min: number;
  max: number;
  step?: number;
  value: number;
};

const {
  class: className,
  id,
  label,
  labelPosition = 'top',
  min,
  max,
  step = 1,
  value,
  ...rest
} = Astro.props;

assertValidSlots(Astro.slots, ['description', 'label'], 'RangeField');

const processedLabel = await matchAsync()
  .on(!!label, () => `<label for="${id}">${label}</label>`)
  .on(Astro.slots.has('label'), async () => {
    const rawLabel = await Astro.slots.render('label');
    const isLabelTag = rawLabel ? /^\s*<label(?=[>\s])/i.test(rawLabel) : false;
    return isLabelTag
      ? rawLabel.replace('<label', `<label for="${id}"`)
      : `<label for="${id}">${rawLabel}</label>`;
  })
  .otherwise(() => null);

const hasDescription = Astro.slots.has('description');
const descriptionId = hasDescription ?`${id}-description` : undefined;

const numberInputId = `${id}-number`;

const Wrapper = processedLabel ? 'div' : Fragment;
const wrapperProps = processedLabel
  ? { class: `input-group ${labelPosition === 'top' ? 'label-top' : 'label-before'}`.trim() }
  : {};
---
<Wrapper {...wrapperProps}>
  <div class="input-container range-container">
    <input
      type="range"
      id={id}
      min={min}
      max={max}
      step={step}
      value={value}
      class:list={['range-input', className]}
      aria-describedby={descriptionId}
      oninput={`document.getElementById('${numberInputId}').value = this.value`}
      {...rest}
    />

    <input
      type="number"
      id={numberInputId}
      min={min}
      max={max}
      step={step}
      value={value}
      class="text-input range-number-input"
      aria-describedby={descriptionId}
      oninput={`document.getElementById('${id}').value = this.value`}
      {...rest}
    />

    {hasDescription && (
      <FieldHelp id={numberInputId} descriptionId={descriptionId}>
        <slot name="description" />
      </FieldHelp>
    )}
  </div>

  {!!processedLabel && <Fragment set:html={processedLabel} />}
</Wrapper>
