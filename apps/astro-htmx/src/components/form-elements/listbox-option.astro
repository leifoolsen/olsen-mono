---
// src/components/form-element/listbox-option.astro

import { assertValidSlots } from '@components/utils/assert-valid-slots.ts';
import type { HTMLAttributes } from 'astro/types';
import './form-elements.css';

type Props = HTMLAttributes<'li'> & {
  disabled?: boolean;
  id: string;
  name: string;
  value: string;
};

const {
  'aria-disabled': ariaDisabled ,
  'aria-selected': ariaSelected = 'false',
  class: className,
  disabled,
  id,
  name,
  role = 'option',
  value,
  ...rest
} = Astro.props;

assertValidSlots(Astro.slots, [], 'ListboxOption');
---
<li
  aria-disabled={disabled ?? ariaDisabled ?? undefined}
  aria-selected={ariaSelected}
  class:list={['listbox-option', className]}
  data-name={name}
  data-value={value}
  id={id}
  role={role}
  {...rest}
>
  <slot />
</li>
