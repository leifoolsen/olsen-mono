---
// src/components/form-element/field-help.astro

import { assertValidSlots } from '@components/utils/assert-valid-slots.ts';
import './form-elements.css';

type Props = {
  id: string;
};

const {
  id,
} = Astro.props;

assertValidSlots(Astro.slots, [], 'FieldHelp');

const anchorName = `--anchor-${id}`;
---
<button
  tabindex="-1"
  type="button"
  class="popover-trigger-btn"
  popovertarget={id}
  aria-label="Show help"
  style={`anchor-name: ${anchorName};`}
>
  ⓘ
</button>

<div
  data-variant="neutral"
  id={id}
  popover="auto"
  class="info-tooltip-popover"
  style={`position-anchor: ${anchorName};`}
>
  <div class="popover-description">
    <span style="font-size: 1.2em;">ⓘ</span>&nbsp;<span><slot /></span>
  </div>
</div>
