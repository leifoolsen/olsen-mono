---
import {assertValidSlots} from '@components/utils/assert-valid-slots.ts';
import { matchAsync } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import './form-elements.css';

type Props = HTMLAttributes<'input'> & {
  id: string;
  label?: string;
  labelPosition?: 'after' | 'before';
}

const {
  class: className,
  id,
  label,
  labelPosition = 'after',
  ...rest
} = Astro.props;

const SLOT_NAMES = ['on-icon', 'off-icon'] as const;
type SlotName = typeof SLOT_NAMES[number];

async function renderIconSlot(slotName: SlotName, componentClass: string) {
  if (!Astro.slots.has(slotName)) return null;

  const rawHtml = await Astro.slots.render(slotName);
  const trimmedHtml = rawHtml.trim();

  if (!trimmedHtml.startsWith('<')) {
    throw new Error(`[ToggleSwitch]: Content in slot="${slotName}" must be wrapped in an HTML element.`);
  }

  const firstTagRegex = /^<([a-z1-6]+)([^>]*)-*>/i;

  return trimmedHtml.replace(firstTagRegex, (_, tagName, attributes) => {
    if (attributes.includes('class="')) {
      const updatedAttributes = attributes.replace('class="', `class="${componentClass} `);
      return `<${tagName}${updatedAttributes}>`;
    } else {
      return `<${tagName} class="${componentClass}"${attributes}>`;
    }
  });
}

assertValidSlots(Astro.slots, [...SLOT_NAMES, 'label'], 'ToggleSwitch');

const processedLabel = await matchAsync()
  .on(!!label, () => `<label for="${id}">${label}</label>`)
  .on(Astro.slots.has('label'), async () => {
    const rawLabel = await Astro.slots.render('label');
    const isLabelTag = rawLabel ? /^\s*<label(?=[>\s])/i.test(rawLabel) : false;
    return isLabelTag
      ? rawLabel.replace('<label', `<label for="${id}"`)
      : `<label for="${id}">${rawLabel}</label>`;
  })
  .otherwise(() => null);

const Wrapper = processedLabel ? 'div' : Fragment;

const wrapperProps = processedLabel
  ? { class: `input-group ${labelPosition === 'before' ? 'label-before' : ''}`.trim() }
  : {};


const onIconHtml = await renderIconSlot('on-icon', 'icon-on');
const offIconHtml = await renderIconSlot('off-icon', 'icon-off');
---
<Wrapper {...wrapperProps}>
  <label class:list={['toggle-switch', className]}>
    <input
      class="switch"
      id={id}
      role="switch"
      type="checkbox"
      {...rest}
    />
    {onIconHtml && <Fragment set:html={onIconHtml} />}
    {offIconHtml && <Fragment set:html={offIconHtml} />}
  </label>

  {!!processedLabel && <Fragment set:html={processedLabel} />}
</Wrapper>
