---
// src/components/svg.astro
import { getSvgData, type SvgName } from '@components/svg/index';
import Icon from '@olsen-mono/astro-icon/icon.astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  name: SvgName;
  size?: string;
  fill?: string;
  stroke?: string;
}

const { name, ...props } = Astro.props;
---

<Icon name={name} {...props} getSvgData={getSvgData} />
