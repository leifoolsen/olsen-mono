---
// src/components/svg.astro
import { getSvgData, type SvgName } from '@components/svg/index';
import { Icon as GlobalSvg } from '@olsen-mono/astro-icon';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  name: SvgName;
  size?: string;
  fill?: string;
  stroke?: string;
}

const props = Astro.props;
---

<GlobalSvg {...props} getSvgData={getSvgData} />
