        <Combobox id="combobox5" placeholder="Select a bird..." label="Disabled combobox" disabled>
          <Fragment slot="options">
            <ListboxGroup>
              <ListboxOption id="cb5-option-1" name="bird" value="falcon">Falcon</ListboxOption>
              <ListboxOption id="cb5--option-2" disabled name="bird" value="winged-horse">
