---
import Checkbox from '@components/form-elements/checkbox.astro';
import Combobox from '@components/form-elements/combobox.astro';
import FieldGroup from '@components/form-elements/field-group.astro';
import InputField from '@components/form-elements/input-field.astro';
import Listbox from '@components/form-elements/listbox.astro';
import ListboxGroup from '@components/form-elements/listbox-group.astro';
import ListboxOption from '@components/form-elements/listbox-option.astro';
import RadioButton from '@components/form-elements/radio-button.astro';
import RangeField from '@components/form-elements/range-field.astro';
import SelectField from '@components/form-elements/select-field.astro';
import TextArea from '@components/form-elements/text-area.astro';
import ToggleSwitch from '@components/form-elements/toggle-switch.astro';
import AppLayout from '@layouts/app-layout.astro';
import '@components/form-elements/form-elements.css';
---

<AppLayout title="Form Elements">
  <h1 id="top">Form Elements</h1>

  <section data-layout="row" style="gap: var(--space-l)">
    <div style="display: flex; gap: var(--space-m); flex-wrap: wrap;">
      <FieldGroup id="forms__toggle-switch_styled" bordered>
        <legend>Toggle Switches</legend>
        <ToggleSwitch
          id="form-elements-switch-unchecked"
          name="form-elements-switch-unchecked"
          aria-label="Toggle light dark theme"
          labelPosition="before"
        >
          <label slot="label">Initially Unchecked</label>
        </ToggleSwitch>

        <ToggleSwitch
          checked
          id="form-elements-switch-checked"
          name="form-elements-switch-checked"
          aria-label="Toggle light dark theme"
          labelPosition="before"
        >
          <label slot="label">Initially Checked</label>
        </ToggleSwitch>

        <ToggleSwitch
          id="form-elements-switch-unchecked-disabled"
          name="form-elements-switch-unchecked-disabled"
          disabled
          aria-label="Toggle light dark theme"
        >
          <label slot="label">Disabled, Unchecked</label>
        </ToggleSwitch>

        <ToggleSwitch
          id="form-elements-switch-checked-disabled"
          name="form-elements-switch-checked-disabled"
          checked
          disabled
          aria-label="Toggle light dark theme"
        >
          <label slot="label">Disabled, Checked</label>
        </ToggleSwitch>

        <ToggleSwitch
          id="form-elements-switch-icon-unchecked"
          name="form-elements-switch-icon-unchecked"
          aria-label="Toggle light dark theme"
        >
          <span slot="on-icon">☀️</span>
          <span slot="off-icon">🌙</span>
          <label slot="label">Initially Unchecked</label>
        </ToggleSwitch>

        <ToggleSwitch
          id="form-elements-switch-icon-checked"
          name="form-elements-switch-icon-checked"
          checked
          aria-label="Toggle light dark theme"
        >
          <span slot="on-icon"><small class="baz"><small>A</small></small>A</span>
          <span slot="off-icon">A<small><small>A</small></small></span>
          <label slot="label">Initially Checked</label>
        </ToggleSwitch>

        <ToggleSwitch
          id="form-elements-switch-icon-disabled-unchecked"
          name="form-elements-switch-icon-disabled-unchecked"
          disabled
          aria-label="Toggle light dark theme"
        >
          <span slot="on-icon">☀️</span>
          <span slot="off-icon">🌙</span>
          <label slot="label">Unchecked, disabled</label>
        </ToggleSwitch>

        <ToggleSwitch
          id="form-elements-switch-icon-disabled-checked"
          name="form-elements-switch-icon-disabled-checked"
          disabled
          checked
          aria-label="Toggle light dark theme"
        >
          <span slot="on-icon"><small><small>A</small></small>A</span>
          <span slot="off-icon">A<small><small>A</small></small></span>
          <label slot="label">Checked, disabled</label>
        </ToggleSwitch>
      </FieldGroup>

      <FieldGroup id="forms__checkbox_styled" bordered>
        <legend>Checkboxes</legend>

        <FieldGroup>
          <Checkbox
            id="form-elements-checkbox"
            name="form-elements-checkbox"
            value="cb1"
            label="Initially Unchecked"
          />
          <Checkbox
            checked
            id="form-elements-checkbox-checked"
            name="form-elements-checkbox-checked"
            value="cb2"
          >
            <span slot="label">Initially Checked</span>
          </Checkbox>
          <Checkbox
            checked
            required
            id="form-elements-checkbox-required"
            name="form-elements-checkbox-required"
            value="cbrequired"
            label="Required"
          />
          <Checkbox
            checked
            invalid
            id="form-elements-checkbox-invalid"
            name="form-elements-checkbox-invalid"
            value="cbinvalid"
          >
            <label slot="label">Invalid</label>
          </Checkbox>
          <Checkbox
            disabled
            id="form-elements-checkbox-disabled"
            name="form-elements-checkbox-disabled"
            value="cb3"
          >
            <label slot="label">Unchecked, Disabled</label>
          </Checkbox>
          <Checkbox
            disabled
            checked
            id="form-elements-checkbox-disabled-checked"
            name="form-elements-checkbox-disabled-checked"
            value="cb4"
            label="Checked, Disabled"
          />
        </FieldGroup>
        <hr />
        <FieldGroup orientation="row">
          <Checkbox
            id="form-elements-checkbox2"
            name="form-elements-checkbox2"
            value="cb1"
            labelPosition="before"
          >
            <span slot="label">Initially Unchecked</span>
          </Checkbox>
          <Checkbox
            checked
            id="form-elements-checkbox-checked2"
            name="form-elements-checkbox-checked2"
            value="cb2"
            labelPosition="before"
          >
            <span slot="label">Initially Checked</span>
          </Checkbox>
        </FieldGroup>
      </FieldGroup>

      <FieldGroup id="forms__radio_styled" bordered>
        <legend>Radio Buttons</legend>

        <FieldGroup role="radiogroup">
          <RadioButton id="form-elements-radio-group-1" name="radioOption" value="1" label="Option 1" />
          <RadioButton id="form-elements-radio-group-2" name="radioOption" value="2" label="Option 2" />
          <RadioButton id="form-elements-radio-group-3" name="radioOption" value="3">
            <label slot="label">Option 3</label>
          </RadioButton>
          <RadioButton
            id="form-elements-radio-group-4"
            name="radioOption"
            value="4"
            checked
            disabled
            label="Disabled Option"
          />
        </FieldGroup>
        <hr />
        <FieldGroup role="radiogroup" orientation="row">
          <RadioButton id="testing-1" name="testing" value="1" disabled labelPosition="before" label="Testing 1..." />
          <RadioButton id="testing-2" name="testing" value="2" disabled checked>
            <span slot="label">Testing 2 ...</span>
          </RadioButton>
        </FieldGroup>
      </FieldGroup>

      <FieldGroup id="forms__radio_styled" bordered style="min-width: 40ch">
        <legend>Range Inputs</legend>

        <RangeField
          id="range-input"
          min={0}
          max={360}
          step={0.1}
          value={303.4}
          label="Range Input"
        >
          <span slot="description">This is a description of the range field input.</span>
        </RangeField>
        <RangeField
          disabled
          id="range-input-disabled"
          min={0}
          max={360}
          step={0.1}
          value={303.4}
          label="Range Input, disabled"
        />
      </FieldGroup>
    </div>

    <div style="display: flex; gap: var(--space-m); flex-wrap: wrap;">
      <FieldGroup id="forms__inputs_styled" bordered style="min-width: 50ch;">
        <legend>Input fields</legend>

        <InputField id="input__text_styled" placeholder="Enter Text" label="Text Input">
          <span slot="description">This is a description of the input.</span>
        </InputField>
        <InputField id="input__number_styled" type="number" placeholder="Enter Number">
          <label slot="label">Number Input</label>
        </InputField>
        <InputField id="input__password_styled" type="password" placeholder="Type your Password">
          <label slot="label">Password</label>
        </InputField>
        <InputField id="input__required_styled" type="text" placeholder="Required Input" required label="Required Input" />
        <InputField
          id="input__text_readonly_styled"
          placeholder="Enter Text"
          value="Read Only"
          readonly
          label="Read Only Text Input"
        />
        <InputField
          id="input__text_disabled_styled"
          placeholder="Enter Text"
          value="Lorem Ipsum"
          disabled
        >
          <span slot="description">This is a description of the disabled text input.</span>
          <span slot="label">Disabled Text Input</span>
        </InputField>
        <InputField
          id="input__text_invalid_styled"
          placeholder="Enter Text"
          value="Lorem Ipsum"
          invalid
          required
        >
          <span slot="label">Invalid Required Text Input</span>
          <span slot="error-message">The input is not valid.</span>
          <span slot="description">This is a description of the invalid required text input.</span>
        </InputField>
        <InputField id="input__date_styled" type="date" value="1970-01-01" label="Date Input">
          <span slot="description">This is a description of the date input.</span>
        </InputField>
      </FieldGroup>

      <FieldGroup id="forms__textareas_styled" bordered style="min-width: 50ch; max-width: 50ch;">
        <legend>Text Areas</legend>

        <TextArea
          id="textarea_styled"
          placeholder="Enter your message here"
          value="Lorem Ipsum Dolar Est!"
          label="Text Area Input"
        />
        <TextArea id="textarea_styled_required" placeholder="Enter your message here" required>
          <span slot="label">Required Text</span>
        </TextArea>
        <TextArea id="textarea_styled_readonly" placeholder="Enter your message here" readonly>
          Lorem Ipsum Dolar Est!
          <label slot="label">Read Only Text</label>
        </TextArea>
        <TextArea
          id="textarea_styled_disabled"
          placeholder="Enter your message here"
          disabled
        >
          Lorem Ipsum Dolar Est!
          <label slot="label">Disabled Text</label>
        </TextArea>
        <TextArea
          id="textarea_styled_required_invalid"
          placeholder="Enter your message here"
          required invalid
          label="Required Invalid Text"
        >
          Lorem Ipsum Dolar Est!
          <span slot="error-message">The input is not valid.</span>
        </TextArea>
      </FieldGroup>

      <FieldGroup id="forms__selects_styled" bordered style="min-width: 50ch; max-width: 50ch;">
        <legend>Native Select</legend>

        <SelectField id="select_styled" label="Select">
          <optgroup label="Option Group">
            <option value="1">Option One</option>
            <option value="2">Option Two</option>
            <option value="3" selected>Option Three</option>
            <option value="4">Option Four has a long text description. Lorem Ipsum Dolar Est!</option>
          </optgroup>
          <Fragment slot="description">This is a description of the select.</Fragment>
        </SelectField>

        <SelectField id="select_styled_required" required>
          <optgroup label="Option Group">
            <option>Option One</option>
            <option>Option Two</option>
            <option>Option Three</option>
            <option value="4">Option Four has a long text description. Lorem Ipsum Dolar Est!</option>
          </optgroup>
          <Fragment slot="label">Select Required</Fragment>
        </SelectField>

        <SelectField id="select_styled_disabled" disabled label="Select Disabled">
          <optgroup label="Option Group">
            <option>Option One</option>
            <option>Option Two</option>
            <option>Option Three</option>
          </optgroup>
          <Fragment slot="description">This is a description of the disabled select.</Fragment>
        </SelectField>

        <SelectField id="select_styled_invalid" invalid label="Select Invalid">
          <optgroup label="Option Group">
            <option>Option One</option>
            <option>Option Two</option>
            <option>Option Three</option>
          </optgroup>
          <Fragment slot="error-message">The input is not valid.</Fragment>
        </SelectField>
      </FieldGroup>

      <FieldGroup id="designsystem__listboxes" bordered style="min-width: 50ch;">
        <legend>Listboxes</legend>

        <div style="display: flex; flex-direction: column; gap: var(--space-xs);">
          <p id="listbox-label">Simple Listbox without Marker</p>
          <Listbox id="listbox" aria-labelledby="listbox-label" bordered>
            <ListboxGroup>
              <ListboxOption id="listbox-option-1" name="option" value="1">Option 1</ListboxOption>
              <ListboxOption id="listbox-option-2" name="option" value="2">Option 2</ListboxOption>
              <ListboxOption id="listbox-option-3" name="option" value="3">Option 3</ListboxOption>
              <ListboxOption id="listbox-option-4" name="option" value="4">Option 4</ListboxOption>
            </ListboxGroup>
          </Listbox>
        </div>

        <script>
          const element = document.getElementById('listbox');
          element?.addEventListener('change', (e) => {
            const customEvent = e as CustomEvent;
            console.log('#listbox:', customEvent.detail);
          });
        </script>

        <div style="display: flex; flex-direction: column; gap: var(--space-xs);">
          <p id="listbox2-label">Grouped Options with Marker</p>
          <Listbox id="listbox2" aria-labelledby="listbox2-label" showMarker bordered activeDescendantId="listbox2-option-5">
            <ListboxGroup label="Land Animals">
              <ListboxOption id="listbox2-option-1" name="animal" value="cat">Cat</ListboxOption>
              <ListboxOption id="listbox2-option-2" name="animal" value="dog">Dog</ListboxOption>
              <ListboxOption id="listbox2-option-3" name="animal" value="tiger">Tiger</ListboxOption>
              <ListboxOption id="listbox2-option-4" name="animal" value="reindeer">Reindeer</ListboxOption>
              <ListboxOption id="listbox2-option-5" name="animal" value="racoon">Raccoon</ListboxOption>
            </ListboxGroup>
            <ListboxGroup label="Water Animals">
              <ListboxOption id="listbox2-option-6" name="animal" value="dolphin">Dolphin</ListboxOption>
              <ListboxOption id="listbox2-option-7" name="animal" value="flounder">Flounder</ListboxOption>
              <ListboxOption id="listbox2-option-8" name="animal" value="eel">Eel</ListboxOption>
            </ListboxGroup>
            <ListboxGroup label="Air Animals">
              <ListboxOption id="listbox2-option-9" name="animal" value="falcon">Falcon</ListboxOption>
              <ListboxOption id="listbox2-option-10" disabled name="animal" value="winged-horse">Winged Horse</ListboxOption>
              <ListboxOption id="listbox2-option-11" name="animal" value="owl">Owl</ListboxOption>
            </ListboxGroup>
          </Listbox>
        </div>
      </FieldGroup>

      <script>
        const element = document.getElementById('listbox2');
        element?.addEventListener('change', (e) => {
          const customEvent = e as CustomEvent;
          console.log('#listbox2:', customEvent.detail);
        });
      </script>

      <FieldGroup id="designsystem__listboxes" bordered style="min-width: 50ch;">
        <legend>Multi Select Listboxes</legend>

        <div style="display: flex; flex-direction: column; gap: var(--space-xs);">
          <p id="ms-listbox-label">Simple Multi Select Listbox</p>
          <Listbox id="ms-listbox" aria-labelledby="listbox-label" multiSelectable bordered>
            <ListboxGroup>
              <ListboxOption id="ms-listbox-option-1" name="option-1" value="1">Option 1</ListboxOption>
              <ListboxOption id="ms-listbox-option-2" name="option-2" value="2">Option 2</ListboxOption>
              <ListboxOption id="ms-listbox-option-3" name="option-3" value="3">Option 3</ListboxOption>
              <ListboxOption id="ms-listbox-option-4" name="option-4" value="4">Option 4</ListboxOption>
            </ListboxGroup>
          </Listbox>
        </div>

        <script>
          const element = document.getElementById('ms-listbox');
          element?.addEventListener('change', (e) => {
            const customEvent = e as CustomEvent;
            console.log('#ms-listbox:', customEvent.detail);
          });
        </script>

        <div style="display: flex; flex-direction: column; gap: var(--space-xs);">
          <p id="ms-listbox2-label">Multi Select Grouped Options</p>
          <div style="display: flex; gap: var(--space-xs); align-items: center;">
            <button type="button" id="ms-listbox2-select-all">Select all</button>
            <button type="button" id="ms-listbox2-empty-selection">Empty selection</button>
          </div>
          <div>
            <InputField
              id="ms-listbox2-search"
              type="search"
              placeholder="Enter search term..."
              aria-label="Search"
              aria-controls="ms-listbox2"
            >
              <span slot="description">Description of the search field</span>
            </InputField>
          </div>
          <Listbox id="ms-listbox2" aria-labelledby="listbox2-label" multiSelectable bordered>
            <ListboxGroup>
              <Fragment slot="label"><span>Land Animals</span><span style="transform: scale(1.2)">𓃰</span></Fragment>
              <ListboxOption id="ms-listbox2-option-1" name="cat" value="cat">Cat</ListboxOption>
              <ListboxOption id="ms-listbox2-option-2" name="dog" value="dog">Dog</ListboxOption>
              <ListboxOption id="ms-listbox2-option-3" name="tiger" value="tiger">Tiger</ListboxOption>
              <ListboxOption id="ms-listbox2-option-4" name="reindeer" value="reindeer">Reindeer</ListboxOption>
              <ListboxOption id="ms-listbox2-option-5" name="racoon" value="racoon">Raccoon</ListboxOption>
            </ListboxGroup>
            <ListboxGroup>
              <Fragment slot="label">Water Animals <span style="transform: scale(1.6)">𓆟</span></Fragment>
              <ListboxOption id="ms-listbox2-option-6" name="dolphin" value="dolphin">Dolphin</ListboxOption>
              <ListboxOption id="ms-listbox2-option-7" name="flounder" value="flounder">Flounder</ListboxOption>
              <ListboxOption id="ms-listbox2-option-8" name="eel" value="eel">Eel</ListboxOption>
              <ListboxOption id="ms-listbox2-option-9" name="trout" value="trout">Trout</ListboxOption>
              <ListboxOption id="ms-listbox2-option-10" name="herring" value="herring">Herring</ListboxOption>
              <ListboxOption id="ms-listbox2-option-11" name="halibut" value="halibut">Halibut</ListboxOption>
            </ListboxGroup>
            <ListboxGroup>
              <Fragment slot="label">Air Animals<span style="transform: scale(1.2)">𓅬</span></Fragment>
              <ListboxOption id="ms-listbox2-option-12" name="falcon" value="falcon">Falcon</ListboxOption>
              <ListboxOption
                id="ms-listbox2-option-13"
                disabled
                name="winged-horse"
                value="winged-horse"
              >
                Winged Horse
              </ListboxOption>
              <ListboxOption id="ms-listbox2-option-14" name="owl" value="owl">Owl</ListboxOption>
            </ListboxGroup>
          </Listbox>
        </div>
      </FieldGroup>

      <script>
        const listbox = document.getElementById('ms-listbox2');
        const searchField = document.getElementById('ms-listbox2-search');
        const selectAllBtn = document.getElementById('ms-listbox2-select-all');
        const emptySelectionBtn = document.getElementById('ms-listbox2-empty-selection');

        listbox?.addEventListener('change', (e) => {
          const customEvent = e as CustomEvent;
          console.log('#ms-listbox2:', customEvent.detail);
        });

        searchField?.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          if (listbox && typeof (listbox as any).filter === 'function') {
            (listbox as any).filter(target.value);
          }
        });

        selectAllBtn?.addEventListener('click', () => {
          if (listbox && typeof (listbox as any).selectAll === 'function') {
            (listbox as any)?.selectAll();
          }
        });

        emptySelectionBtn?.addEventListener('click', () => {
          if (listbox && typeof (listbox as any).deselectAll === 'function') {
            (listbox as any)?.deselectAll();
          }
        });
      </script>

      <FieldGroup id="designsystem__comboboxes" bordered style="min-width: 50ch;">
        <legend>Comboboxes</legend>

        <Combobox id="combobox" placeholder="Start typing to filter..." label="Select a fish" invalid>
          <span slot="description">Description of the combobox</span>

          <Fragment slot="options">
            <ListboxGroup>
              <ListboxOption id="cb-option-6" name="fish" value="dolphin">Dolphin</ListboxOption>
              <ListboxOption id="cb-option-7" name="fish" value="flounder">Flounder</ListboxOption>
              <ListboxOption id="cb-option-8" name="fish" value="eel">Eel</ListboxOption>
              <ListboxOption id="cb-option-9" name="fish" value="trout">Trout</ListboxOption>
              <ListboxOption id="cb-option-10" name="fish" value="herring">Herring</ListboxOption>
              <ListboxOption id="cb-option-11" name="fish" value="halibut">Halibut</ListboxOption>
              <ListboxOption id="cb-option-12" name="fish" value="triggerfish">Humuhumunukunukuāpuaʻa</ListboxOption>
            </ListboxGroup>
          </Fragment>
        </Combobox>

        <script>
          const cb = document.getElementById('combobox');

          cb?.addEventListener('change', (e) => {
            const customEvent = e as CustomEvent;
            console.log('#combobox:', customEvent.detail);
          });
        </script>

        <Combobox id="combobox2" placeholder="Start typing to filter..." label="Select a land animal">
          <Fragment slot="options">
            <ListboxGroup>
              <ListboxOption id="cb2-option-1" name="land" value="cat">Cat</ListboxOption>
              <ListboxOption id="cb2-option-2" name="land" value="dog">Dog</ListboxOption>
              <ListboxOption id="cb2-option-3" name="land" value="tiger">Tiger</ListboxOption>
              <ListboxOption id="cb2-option-4" name="land" value="reindeer">Reindeer</ListboxOption>
              <ListboxOption id="cb2-option-5" name="land" value="racoon">Raccoon</ListboxOption>
            </ListboxGroup>
          </Fragment>
        </Combobox>

        <Combobox id="combobox3" placeholder="Start typing to filter..." label="Multi selectable combobox" multiSelectable>
          <Fragment slot="options">
            <ListboxGroup>
              <Fragment slot="label"><span>Land Animals</span><span style="transform: scale(1.2)">𓃰</span></Fragment>
              <ListboxOption id="cb3-option-1" name="cat" value="cat">Cat</ListboxOption>
              <ListboxOption id="cb3-option-2" name="dog" value="dog">Dog</ListboxOption>
              <ListboxOption id="cb3-option-3" name="tiger" value="tiger">Tiger</ListboxOption>
              <ListboxOption id="cb3-option-4" name="reindeer" value="reindeer">Reindeer</ListboxOption>
              <ListboxOption id="cb3-option-5" name="racoon" value="racoon">Raccoon</ListboxOption>
            </ListboxGroup>
            <ListboxGroup>
              <Fragment slot="label">Water Animals <span style="transform: scale(1.6)">𓆟</span></Fragment>
              <ListboxOption id="cb3--option-6" name="dolphin" value="dolphin">Dolphin</ListboxOption>
              <ListboxOption id="cb3-option-7" name="flounder" value="flounder">Flounder</ListboxOption>
              <ListboxOption id="cb3--option-8" name="eel" value="eel">Eel</ListboxOption>
              <ListboxOption id="cb3--option-9" name="trout" value="trout">Trout</ListboxOption>
              <ListboxOption id="cb3--option-10" name="herring" value="herring">Herring</ListboxOption>
              <ListboxOption id="cb3--option-11" name="halibut" value="halibut">Halibut</ListboxOption>
            </ListboxGroup>
            <ListboxGroup>
              <Fragment slot="label">Air Animals<span style="transform: scale(1.2)">𓅬</span></Fragment>
              <ListboxOption id="cb3--option-12" name="falcon" value="falcon">Falcon</ListboxOption>
              <ListboxOption id="cb3--option-13" disabled name="winged-horse" value="winged-horse">
                Winged Horse
              </ListboxOption>
              <ListboxOption id="cb3--option-14" name="owl" value="owl">Owl</ListboxOption>
              <ListboxOption id="cb3--option-15" name="sparrow" value="sparrow">Sparrow</ListboxOption>
              <ListboxOption id="cb3--option-16" name="mallard" value="mallard">Mallard</ListboxOption>
              <ListboxOption id="cb3--option-17" name="vulture" value="vulture">Vulture</ListboxOption>
              <ListboxOption id="cb3--option-18" name="penguin" value="penguin">Penguin</ListboxOption>
            </ListboxGroup>
          </Fragment>
        </Combobox>

        <script>
          const cb3 = document.getElementById('combobox3');

          cb3?.addEventListener('change', (e) => {
            const customEvent = e as CustomEvent;
            console.log('#combobox3:', customEvent.detail);
          });
        </script>

        <Combobox id="combobox4" placeholder="Select a bird..." label="Select only" readonly>
          <span slot="description">Description of the select only</span>

          <Fragment slot="options">
            <ListboxGroup>
              <ListboxOption id="cb4-option-1" name="bird" value="falcon">Falcon</ListboxOption>
              <ListboxOption id="cb4--option-2" disabled name="bird" value="winged-horse">
                Winged Horse
              </ListboxOption>
              <ListboxOption id="cb4--option-3" name="bird" value="owl">Owl</ListboxOption>
              <ListboxOption id="cb4--option-4" name="bird" value="sparrow">Sparrow</ListboxOption>
              <ListboxOption id="cb4--option-5" name="bird" value="mallard">Mallard</ListboxOption>
              <ListboxOption id="cb4--option-6" name="bird" value="vulture">Vulture</ListboxOption>
              <ListboxOption id="cb4--option-7" name="bird" value="penguin">Penguin</ListboxOption>
              <ListboxOption id="cb4--option-8" name="bird" value="long text">Penguin</ListboxOption>
            </ListboxGroup>
          </Fragment>
