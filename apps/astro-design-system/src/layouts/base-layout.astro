---
// src/layouts/BaseLayout.astro
import '@styles/style.css';
import { Font } from 'astro:assets';

type Props = {
  title: string;
};

const { title } = Astro.props;
const theme = Astro.cookies.get('theme')?.value || 'dark';
const density = Astro.cookies.get('density')?.value || 'default';
---

<!doctype html>
<html lang="en" data-theme={theme} data-density={density}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <Font cssVariable="--titillium" />
    <Font cssVariable="--open-sans" />
    <Font cssVariable="--inconsolata" />
    <style is:inline>
      @layer reset, tokens, base, layout, components;
      :root {
        --font-family-heading: var(--titillium, sans-serif);
        --font-family-main: var(--open-sans, sans-serif);
        --font-family-mono: var(--inconsolata, monospace);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
