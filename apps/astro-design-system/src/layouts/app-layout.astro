---
import ApplicationMenu from '@components/ApplicationMenu.astro';
import ToggleSwitch from '@olsen-mono/astro-forms/ToggleSwitch.astro';
import { chevronPointingLeftLines, chevronPointingRightLines } from '@olsen-mono/astro-svg';
import MorphLinesIcon from '@olsen-mono/astro-svg/MorphLinesIcon.astro';
import BaseLayout from './base-layout.astro';

type Props = {
  title: string;
};

const { title } = Astro.props;
const isCondensed = Astro.cookies.get('density')?.value === 'condensed';
const isLight = Astro.cookies.get('theme')?.value === 'light';
---

<BaseLayout title={title}>
  <div class="app-grid" data-sidebar-collapsed="false" id="app-container">
    <header class="app-header" data-variant="primary-surface">
      <div class="app-header-left">
        <button
          id="sidebar-toggle"
          class="app-sidebar-toggle"
          aria-label="Toggle menu"
          aria-controls="app-sidebar"
          aria-expanded="true"
          type="button"
          data-border-radius="xs"
        >
          <MorphLinesIcon fromLines={chevronPointingRightLines} toLines={chevronPointingLeftLines} active size="1.5" />
        </button>
        <div data-font-size="xl">@olsen-mono Design System</div>
      </div>

      <div class="app-header-right" id="app-header-right">
        <ToggleSwitch id="density-toggle" name="density" checked={isCondensed} aria-label="Toggle font size">
          <span slot="on-icon">
            <small>
              <small>A</small>
            </small>
            A
          </span>
          <span slot="off-icon">
            A
            <small>
              <small>A</small>
            </small>
          </span>
        </ToggleSwitch>
        <ToggleSwitch id="theme-switcher" name="theme" checked={isLight} aria-label="Toggle light dark theme">
          <span slot="on-icon">☀️</span>
          <span slot="off-icon">🌙</span>
        </ToggleSwitch>
      </div>
    </header>

    <aside class="app-sidebar" id="app-sidebar" data-variant="secondary-surface">
      <nav>
        <ApplicationMenu />
      </nav>
    </aside>

    <main class="app-main" id="app-main">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .app-grid {
    --_sidebar-width: 18.75rem;
    --_header-height: 4rem;

    display: grid;
    grid-template-rows: var(--_header-height) 1fr;
    grid-template-columns: var(--_sidebar-width) 1fr;
    grid-template-areas:
      'header header'
      'sidebar main';
    min-block-size: 100svb;
    transition: grid-template-columns 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .app-grid[data-sidebar-collapsed='true'] {
    --_sidebar-width: 0;
  }

  .app-header {
    grid-area: header;
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-m);
    border-bottom: 1px solid var(--muted-border-color);
    background-color: oklch(from var(--swatch-color) l c h / 0.9);
  }

  @supports (backdrop-filter: blur(8px)) or (-webkit-backdrop-filter: blur(8px)) {
    .app-header {
      background-color: oklch(from var(--swatch-color) l c h / 0.84);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  }

  .app-header-left,
  .app-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .app-sidebar-toggle {
    background: none;
    border: none;
    border-radius: var(--space-2xs);
    cursor: pointer;
    padding: 0;
    font-size: var(--font-size-xl);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .app-sidebar {
    grid-area: sidebar;
    border-inline-end: 1px solid var(--muted-border-color);
    overflow-y: auto;
    overflow-x: hidden;
    position: sticky;
    top: var(--_header-height);
    height: calc(100dvh - var(--_header-height));
  }

  .app-main {
    grid-area: main;
    overflow-y: auto;
    padding: var(--space-l);
  }

  @media (max-width: 48rem) {
    .app-grid {
      grid-template-columns: 0 1fr;
    }

    .app-grid[data-sidebar-collapsed='false'] {
      --_sidebar-width: 100dvi;
      position: fixed;
      inset: 0;
      z-index: 200;
    }
  }
</style>

<script>
  const appContainer = document.getElementById('app-container');

  function setupListeners() {
    if (!appContainer || appContainer.hasAttribute('data-initialized')) return;
    appContainer.setAttribute('data-initialized', 'true');

    const toggleBtn = document.getElementById('sidebar-toggle');

    if (toggleBtn) {
      const svg = toggleBtn.querySelector('svg');

      if (appContainer?.getAttribute('data-sidebar-collapsed') !== 'true') {
        svg?.setAttribute('aria-checked', 'true');
      }

      toggleBtn?.addEventListener('click', () => {
        const isCollapsed = appContainer?.getAttribute('data-sidebar-collapsed') === 'true';
        appContainer?.setAttribute('data-sidebar-collapsed', isCollapsed ? 'false' : 'true');
        svg?.setAttribute('aria-checked', Boolean(isCollapsed).toString());
      });
    }

    const headerRight = document.getElementById('app-header-right');
    if (!headerRight) return;

    headerRight.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement | null;
      if (input instanceof HTMLInputElement && input.type === 'checkbox') {
        const name = input.name;
        const checked = input.checked;

        let cookieValue = '';
        let htmlAttribute = '';

        if (name === 'density') {
          cookieValue = checked ? 'condensed' : 'default';
          htmlAttribute = 'data-density';
        } else if (name === 'theme') {
          cookieValue = checked ? 'light' : 'dark';
          htmlAttribute = 'data-theme';
        }

        if (!cookieValue || !htmlAttribute) return;

        document.documentElement.setAttribute(htmlAttribute, cookieValue);
        document.cookie = `${name}=${cookieValue}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Strict`;
      }
    });
  }

  setupListeners();
  document.addEventListener('astro:after-swap', setupListeners);
</script>
