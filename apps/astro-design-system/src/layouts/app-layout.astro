---
import '@styles/app-layout.css';
import ToggleSwitch from '@olsen-mono/astro-forms/ToggleSwitch.astro';
import { chevronPointingRightLines, xLines } from '@olsen-mono/astro-morph-icons';
import MorphIcon from '@olsen-mono/astro-morph-icons/MorphIcon.astro';
import BaseLayout from './base-layout.astro';

type Props = {
  title: string;
};

const { title } = Astro.props;
const isCondensed = Astro.cookies.get('density')?.value === 'condensed';
const isLight = Astro.cookies.get('theme')?.value === 'light';
---

<BaseLayout title={title}>
  <div class="app-grid" data-sidebar-collapsed="false" id="app-container">
    <header class="app-header" data-elevation="s">
      <div class="app-header-left">
        <button
          id="sidebar-toggle"
          class="app-sidebar-toggle"
          aria-label="Toggle menu"
          type="button"
          data-border-radius="xs"
        >
          <MorphIcon fromLines={chevronPointingRightLines} toLines={xLines} active />
        </button>
        <div data-font-size="xl">Astro Design System</div>
      </div>

      <div class="app-header-right" id="app-header-right">
        <ToggleSwitch id="density-toggle" name="density" checked={isCondensed} aria-label="Toggle font size">
          <span slot="on-icon">
            <small>
              <small>A</small>
            </small>
            A
          </span>
          <span slot="off-icon">
            A
            <small>
              <small>A</small>
            </small>
          </span>
        </ToggleSwitch>
        <ToggleSwitch id="theme-switcher" name="theme" checked={isLight} aria-label="Toggle light dark theme">
          <span slot="on-icon">☀️</span>
          <span slot="off-icon">🌙</span>
        </ToggleSwitch>
      </div>
    </header>

    <aside class="app-sidebar">
      <nav>
        <ul class="app-sidebar-nav-list" data-font-size="m">
          <li>
            <a href="/html5-test-page">👉 HTML5 Test Page</a>
          </li>
          <li>
            <a href="/design-system-test-page">👉 Designsystem Test Page</a>
          </li>
          <li>
            <a href="/form-elements">👉 Form Elements</a>
          </li>
        </ul>
      </nav>
    </aside>

    <main class="app-main">
      <slot />
    </main>
  </div>
</BaseLayout>

<script>
  const appContainer = document.getElementById('app-container');

  function setupListeners() {
    if (!appContainer || appContainer.hasAttribute('data-initialized')) return;
    appContainer.setAttribute('data-initialized', 'true');

    const toggleBtn = document.getElementById('sidebar-toggle');

    if (toggleBtn) {
      const svg = toggleBtn.querySelector('svg');

      if (appContainer?.getAttribute('data-sidebar-collapsed') !== 'true') {
        svg?.setAttribute('aria-checked', 'true');
      }

      toggleBtn?.addEventListener('click', () => {
        const isCollapsed = appContainer?.getAttribute('data-sidebar-collapsed') === 'true';
        appContainer?.setAttribute('data-sidebar-collapsed', isCollapsed ? 'false' : 'true');
        svg && svg.setAttribute('aria-checked', Boolean(isCollapsed).toString());
      });
    }

    const headerRight = document.getElementById('app-header-right');
    if (!headerRight) return;

    headerRight.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement | null;
      if (input instanceof HTMLInputElement && input.type === 'checkbox') {
        const name = input.name;
        const checked = input.checked;

        let cookieValue = '';
        let htmlAttribute = '';

        if (name === 'density') {
          cookieValue = checked ? 'condensed' : 'default';
          htmlAttribute = 'data-density';
        } else if (name === 'theme') {
          cookieValue = checked ? 'light' : 'dark';
          htmlAttribute = 'data-theme';
        }

        if (!cookieValue || !htmlAttribute) return;

        document.documentElement.setAttribute(htmlAttribute, cookieValue);
        document.cookie = `${name}=${cookieValue}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Strict`;
      }
    });
  }

  setupListeners();
  document.addEventListener('astro:after-swap', setupListeners);
</script>
