---
const variants = ['primary', 'secondary', 'tertiary', 'success', 'info', 'warning', 'error', 'neutral', 'white-black'];
---

<article>
  <h2>Color Variants</h2>

  <div
    data-layout="ram"
    data-container-viewport
    style="--layout-gap: var(--space-2xl); --layout-grid-item-min: 30rem; margin-bottom: 3rem"
  >
    {variants.map((variant) => (
      <div data-variant={variant} class="variant-box">
        <span style="color: var(--brand-contrast); grid-column: span 2;">Brand contrast ({variant})</span>

        <span>Normal text</span>
        <span>Normal text</span>

        <span style="color: var(--brand-text-color);">--brand-text-color</span>
        <span style="color: var(--brand-text-color);">Brand Text Color</span>

        <span style="color: var(--subtle-text);">--subtle-text</span>
        <span style="color: var(--subtle-text);">Subtle Text</span>

        <span style="color: var(--muted-text);">--muted-text</span>
        <span style="color: var(--muted-text);">Muted Text</span>

        <span>--border-color</span>
        <span style="height: stretch; border: 1px solid var(--border-color)" />

        <span>--subtle-border-color</span>
        <span style="height: stretch; border: 1px solid var(--subtle-border-color)" />

        <span>--muted-border-color</span>
        <span style="height: stretch; border: 1px solid var(--muted-border-color)" />
      </div>
    ))}

    <div>
      <div data-variant="primary" class="variant-box">
        <span>Normal text</span>
        <span>Normal text</span>

        <span style="color: var(--brand-text-color);">--brand-text-color</span>
        <span style="color: var(--brand-text-color);">Brand Text Color</span>

        <span style="color: var(--subtle-text);">--subtle-text</span>
        <span style="color: var(--subtle-text);">Subtle Text</span>

        <span style="color: var(--muted-text);">--muted-text</span>
        <span style="color: var(--muted-text);">Muted Text</span>

        <span>--border-color</span>
        <span style="height: stretch; border: 1px solid var(--border-color)" />

        <div style="grid-column: span 2;">
          <div data-variant="tertiary" class="variant-box">
            <span>Normal text</span>
            <span>Normal text</span>

            <span style="color: var(--brand-text-color);">--brand-text-color</span>
            <span style="color: var(--brand-text-color);">Brand Text Color</span>

            <span style="color: var(--subtle-text);">--subtle-text</span>
            <span style="color: var(--subtle-text);">Subtle Text</span>

            <span style="color: var(--muted-text);">--muted-text</span>
            <span style="color: var(--muted-text);">Muted Text</span>

            <span>--border-color</span>
            <span style="height: stretch; border: 1px solid var(--border-color)" />
          </div>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .variant-box {
    position: relative;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 16rem auto;
    grid-auto-rows: min-content;
    background-color: var(--swatch-color);
    color: var(--normal-text);
    padding-inline: var(--space-m);
    padding-block: var(--space-m);
    border-radius: var(--space-xs);
    box-shadow: var(--shadow-2xl);
    transition:
      box-shadow 0.2s ease,
      background-color 0.2s ease;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: var(--inset-shadow-s);
      pointer-events: none;
    }

    &:hover {
      --swatch-color: var(--shade-400);
    }
  }
</style>
