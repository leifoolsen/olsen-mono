---
import { applicationMenuItems } from './application-menu';
---

<ul
  class="app-sidebar-nav-list"
  style="margin-block-start: var(--space-m); display: flex; flex-direction: column; gap: var(--space-xs);"
>
  {applicationMenuItems.map(({ href, label }) => (
    <li>
      <a href={href}>👉 {label}</a>
    </li>
  ))}
</ul>

<style>
  .app-sidebar-nav-list {
    list-style: none;
    padding: var(--space-m);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
</style>
