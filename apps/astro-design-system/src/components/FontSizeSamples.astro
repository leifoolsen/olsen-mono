---

<article
  style="
    display: grid;
    grid-template-columns: repeat( 2, fit-content(80ch) );
    gap: var(--space-xs) var(--space-l);
    align-items: baseline;
  "
>
  <output style="font-size: var(--font-size-s);">
    <span>--font-size-5xl /&nbsp;</span>
    <span>data-font-size="5xl"</span>
  </output>
  <div data-font-size="5xl">Font size 5xl</div>

  <output style="font-size: var(--font-size-s);">
    <span>--font-size-4xl /&nbsp;</span>
    <span>data-font-size="4xl"</span>
  </output>
  <div data-font-size="4xl">Font size 4xl</div>

  <output style="font-size: var(--font-size-s);">
    <span>--font-size-3xl /&nbsp;</span>
    <span>data-font-size="3xl"</span>
  </output>
  <div data-font-size="3xl">Font size 3xl</div>

  <output style="font-size: var(--font-size-s);">
    <span>--font-size-2xl /&nbsp;</span>
    <span>data-font-size="2xl"</span>
  </output>
  <div data-font-size="2xl">Font size 2xl</div>

  <output style="font-size: var(--font-size-s);">
    <span>--font-size-xl&nbsp;&nbsp;/&nbsp;</span>
    <span>data-font-size="xl"</span>
  </output>
  <div data-font-size="xl">Font size xl</div>

  <output style="font-size: var(--font-size-s);">
    <span>--font-size-l&nbsp;&nbsp;&nbsp;/&nbsp;</span>
    <span>data-font-size="l"</span>
  </output>
  <div data-font-size="l">Font size l</div>

  <output style="font-size: var(--font-size-s);">
    <span>--font-size-m&nbsp;&nbsp;&nbsp;/&nbsp;</span>
    <span>data-font-size="m"</span>
  </output>
  <div data-font-size="m">Font size m</div>

  <output style="font-size: var(--font-size-s);">
    <span>--font-size-s&nbsp;&nbsp;&nbsp;/&nbsp;</span>
    <span>data-font-size="s"</span>
  </output>
  <div data-font-size="s">Font size s</div>

  <output style="font-size: var(--font-size-s);">
    <span>--font-size-xs&nbsp;&nbsp;/&nbsp;</span>
    <span>data-font-size="xs"</span>
  </output>
  <div data-font-size="xs">Font size xs</div>
</article>
