---
---

<article
  data-layout="ram"
  style="
    --layout-gap: var(--space-m) var(--space-l);
    --layout-grid-item-min: 18rem;
  "
>
  <div class="border-radius-demo" data-border-radius="4xs">
    <output style="font-size: var(--font-size-s);">
      --space-4xs <br /> data-border-radius="4xs"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="3xs">
    <output style="font-size: var(--font-size-s);">
      --space-3xs <br /> data-border-radius="3xs"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="2xs">
    <output style="font-size: var(--font-size-s);">
      --space-2xs <br /> data-border-radius="2xs"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="xs">
    <output style="font-size: var(--font-size-s);">
      --space-xs <br /> data-border-radius="xs"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="s">
    <output style="font-size: var(--font-size-s);">
      --space-s <br /> data-border-radius="s"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="m">
    <output style="font-size: var(--font-size-s);">
      --space-m <br /> data-border-radius="m"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="l">
    <output style="font-size: var(--font-size-s);">
      --space-l <br /> data-border-radius="l"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="xl">
    <output style="font-size: var(--font-size-s);">
      --space-xl <br /> data-border-radius="xl"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="2xl">
    <output style="font-size: var(--font-size-s);">
      --space-2xl <br /> data-border-radius="2xl"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="3xl">
    <output style="font-size: var(--font-size-s);">
      --space-3xl <br /> data-border-radius="3xl"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="4xl">
    <output style="font-size: var(--font-size-s);">
      --space-4xl <br /> data-border-radius="4xl"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="5xl">
    <output style="font-size: var(--font-size-s);">
      --space-5xl <br /> data-border-radius="5xl"
    </output>
  </div>

  <div class="border-radius-demo" data-border-radius="infinity">
    <output style="font-size: var(--font-size-s);">data-border-radius="infinity"</output>
  </div>

  <div class="border-radius-demo" data-border-radius="infinity" style="aspect-ratio: 1; place-self: center;">
    <output style="font-size: var(--font-size-s);">data-border-radius="infinity"</output>
  </div>
</article>

<style>
  .border-radius-demo {
    border: 1px solid currentColor;
    height: 10rem;
    display: grid;
    place-items: center;
    text-align: center;
  }
</style>
