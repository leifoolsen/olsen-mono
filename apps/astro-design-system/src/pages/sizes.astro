---
// src/pages/style-queries.astro

import AppLayout from '@layouts/app-layout.astro';
import '@olsen-mono/css-foundation/color-tokens.css';
---

<AppLayout title="Style Queries">
  <div style="display: flex; flex-direction: column; gap: var(--space-l);">
    <section>
      <div data-font-size="5xl">Font size 5xl</div>
      <div data-font-size="4xl">Font size 4xl</div>
      <div data-font-size="3xl">Font size 3xl</div>
      <div data-font-size="2xl">Font size 2xl</div>
      <div data-font-size="xl">Font size xl</div>
      <div data-font-size="l">Font size l</div>
      <div data-font-size="m">Font size m</div>
      <div data-font-size="s">Font size s</div>
      <div data-font-size="xs">Font size xs</div>
    </section>

    <section>
      <h2>Spacing</h2>
      <div
        data-variant="primary"
        style="
      background-color: transparent;
      color: white;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-s);
      align-items: center;
      transform: rotate(-90deg);
      transform-origin: top left;
      margin-block-start: calc(var(--space-4xl) * 2);
    "
      >
        <div style="transform: rotate(90deg); margin-inline: auto">4xs</div>
        <div data-shade="100" style="width: var(--space-4xs); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">3xs</div>
        <div data-shade="200" style="width: var(--space-3xs); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">2xs</div>
        <div data-shade="300" style="width: var(--space-2xs); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">xs</div>
        <div data-shade="400" style="width: var(--space-xs); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">s</div>
        <div data-shade="500" style="width: var(--space-s); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">m</div>
        <div data-shade="600" style="width: var(--space-m); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">l</div>
        <div data-shade="700" style="width: var(--space-l); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">xl</div>
        <div data-shade="800" style="width: var(--space-xl); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">2xl</div>
        <div data-shade="A100" style="width: var(--space-2xl); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">3xl</div>
        <div data-shade="A200" style="width: var(--space-3xl); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">4xl</div>
        <div data-shade="A400" style="width: var(--space-4xl); height: var(--space-l)"></div>
        <div style="transform: rotate(90deg); margin-inline: auto">5xl</div>
        <div data-shade="A700" style="width: var(--space-5xl); height: var(--space-l)"></div>
      </div>
    </section>

    <section style="margin-block-start: calc(var(--space-4xl) * -3.4)">
      <h2>Border Radius</h2>
      <div data-variant="secondary" data-layout="ram" style="gap: var(--space-m); background-color: transparent;">
        <div
          data-shade="50"
          data-border-radius="4xs"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">4xs</span>
        </div>
        <div
          data-shade="100"
          data-border-radius="3xs"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">3xs</span>
        </div>
        <div
          data-shade="200"
          data-border-radius="2xs"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">2xs</span>
        </div>
        <div
          data-shade="300"
          data-border-radius="xs"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">xs</span>
        </div>
        <div
          data-shade="400"
          data-border-radius="s"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">s</span>
        </div>
        <div
          data-shade="500"
          data-border-radius="m"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">m</span>
        </div>
        <div
          data-shade="600"
          data-border-radius="l"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">l</span>
        </div>
        <div
          data-shade="700"
          data-border-radius="xl"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">xl</span>
        </div>
        <div
          data-shade="800"
          data-border-radius="2xl"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">2xl</span>
        </div>
        <div
          data-shade="900"
          data-border-radius="3xl"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">3xl</span>
        </div>
        <div
          data-shade="A100"
          data-border-radius="4xl"
          style="height: calc(var(--space-2xl) * 3); display: grid; place-items: center"
        >
          <span data-font-size="xl">4xl</span>
        </div>
        <div style="margin: auto">
          <div
            data-font-size="xl"
            data-shade="A200"
            data-border-radius="infinity"
            style="height: calc(var(--space-2xl) * 3); aspect-ratio: 1 / 1; display: grid; place-items: center"
          >
            <span data-font-size="xl">∞</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</AppLayout>
