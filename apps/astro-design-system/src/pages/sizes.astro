---
import BorderRadiuses from '@components/BorderRadiuses.astro';
import FontSizes from '@components/FontSizes.astro';
import Shadows from '@components/Shadows.astro';
import Spacings from '@components/Spacings.astro';
import AppLayout from '@layouts/app-layout.astro';
---

<AppLayout title="Sizes">
  <section>
    <header>
      <h1>Font Sizes</h1>
    </header>
    <FontSizes />

    <h2>Container Viewport</h2>
    <div data-container-viewport>
      <FontSizes />
    </div>

    <h1>Spacing</h1>
    <Spacings />

    <h1>Border Radiuses</h1>
    <BorderRadiuses />

    <h1>Shadows</h1>
    <Shadows />
  </section>
</AppLayout>
