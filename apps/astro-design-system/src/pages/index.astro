---
import ApplicationMenu from '@components/ApplicationMenu.astro';
import AppLayout from '@layouts/app-layout.astro';
---

<AppLayout title="@olsen-mono Design System">
  <section>
    <header>
      <h1 data-font-size="5xl">Welcome</h1>
    </header>
    <p data-font-size="xl" style="font-weight: normal">
      This app is an implementation of my data driven design system in Astro.
    </p>
  </section>

  <nav style="margin-block-start: var(--space-xl);">
    <ApplicationMenu />
  </nav>
</AppLayout>
