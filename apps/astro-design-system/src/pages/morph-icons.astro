---
// src/pages/morph-icons.astro

import AppLayout from '@layouts/app-layout.astro';
import Combobox from '@olsen-mono/astro-forms/Combobox.astro';
import Listbox from '@olsen-mono/astro-forms/Listbox.astro';
import ListboxGroup from '@olsen-mono/astro-forms/ListboxGroup.astro';
import ListboxOption from '@olsen-mono/astro-forms/ListboxOption.astro';
import { arrowPointingDownLines, arrowPointingLeftLines, lineIcons } from '@olsen-mono/astro-morph-icons';
import MorphLinesIcon from '@olsen-mono/astro-morph-icons/MorphLinesIcon.astro';
---

<AppLayout title="Morph Lines Icons">
  <h1 id="top">Morph Lines Icons</h1>
  <p>
    A MorphLinesIcon is a custom Astro component that animates SVG line segments from one shape to another. It's
    designed to be used with a button or toggle, and can be customized with various properties to control the animation.
    It is a highly performant, accessible, and mathematically sound SVG{' '}
    <strong>micro-interaction icon component</strong>.
  </p>

  <h2>Morph Lines Icons Test Bench</h2>

  <div id="morph-inputs" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
    <div>
      <Combobox id="morph-from" placeholder="Select an icon..." label="Select the start icon" readonly>
        <Listbox id="morph-from-options" slot="options" showMarker>
          <ListboxGroup>
            {Array.from(lineIcons.entries()).map((data, index) => (
              <ListboxOption id={`morph-from-${data[0]}`} name="morphFrom" value={data[0]} aria-selected={index === 0}>
                <span>{data[0]}</span>
                <MorphLinesIcon fromLines={data[1]} toLines={data[1]} />
              </ListboxOption>
            ))}
          </ListboxGroup>
        </Listbox>
      </Combobox>
    </div>

    <div>
      <Combobox id="morph-to" placeholder="Select an icon..." label="Select the stop icon" readonly>
        <Listbox id="morph-to-options" slot="options" showMarker>
          <ListboxGroup>
            {Array.from(lineIcons.entries()).map((data, index) => (
              <ListboxOption id={`morph-to-${data[0]}`} name="morphTo" value={data[0]} aria-selected={index === 1}>
                <span>{data[0]}</span>
                <MorphLinesIcon fromLines={data[1]} toLines={data[1]} />
              </ListboxOption>
            ))}
          </ListboxGroup>
        </Listbox>
      </Combobox>
    </div>

    <button
      id="morph-button"
      class="app-sidebar-toggle"
      aria-label="Toggle menu"
      type="button"
      data-border-radius="xs"
      style="height: 3rem; width: 3rem; font-size: 3rem; margin-top: 1rem; border: 1px solid currentColor;"
    >
      <MorphLinesIcon fromLines={arrowPointingDownLines} toLines={arrowPointingLeftLines} airy />
    </button>

    <div
      id="morph-toggle"
      style="
      height: 3rem;
      width: 3rem;
      font-size: 3rem;
      display: grid;
      place-items: center;
      margin-top: 1rem;
      border: 1px solid currentColor;
      border-radius: 5px;"
    >
      <MorphLinesIcon fromLines={arrowPointingDownLines} toLines={arrowPointingLeftLines} active airy hover />
    </div>
  </div>

  <br />
  <div
    style="display: grid;
	  grid-template-columns: repeat(auto-fit, 2.5rem);
	  gap: 1rem;
	  max-width: 40em;"
  >
    {Array.from(lineIcons.entries()).map((data) => (
      <span style="font-size: 2.5rem; display: grid; place-items: center; width: 2rem;">
        <MorphLinesIcon
          fromLines={data[1]}
          toLines={data[1]}
          name={data[0]}
          style="border: 1px solid var(--border-color);"
        />
      </span>
    ))}
  </div>
</AppLayout>

<script>
  import type { ComboboxChangeEventDetail, ListboxItem } from '@olsen-mono/astro-forms';
  import { lineIcons, type LineSegment, type MorphLinesIconElement } from '@olsen-mono/astro-morph-icons';

  const inputContainer = document.getElementById('morph-inputs');

  const updateMorphIcon = (svg: MorphLinesIconElement | null, fromLines: LineSegment[], toLines: LineSegment[]) => {
    if (svg && typeof svg.setFromToLines === 'function') {
      svg.setFromToLines(fromLines, toLines);
    }
  };

  function setupContainer() {
    if (!inputContainer || inputContainer.hasAttribute('data-initialized')) return;

    const morphButton = document.getElementById('morph-button');
    const morphToggle = document.getElementById('morph-toggle');
    const morphPathButton = document.getElementById('morph-path-button');

    const state: Record<string, LineSegment[] | undefined> = {
      morphFrom: lineIcons.get('arrowPointingDownLines'),
      morphTo: lineIcons.get('arrowPointingLeftLines'),
    };

    inputContainer.addEventListener('ui:combobox-change', (e) => {
      const customEvent = e as CustomEvent<ComboboxChangeEventDetail>;
      const data = !Array.isArray(customEvent.detail) ? customEvent.detail : ({} as ListboxItem);

      const name = data?.name;
      const value = data?.value;
      state[name] = lineIcons.get(value!);

      const morphButtonSvg = morphButton && morphButton.querySelector<MorphLinesIconElement>('svg');
      const morphToggleSvg = morphToggle && morphToggle.querySelector<MorphLinesIconElement>('svg');

      updateMorphIcon(morphButtonSvg, state.morphFrom!, state.morphTo!);
      updateMorphIcon(morphToggleSvg, state.morphFrom!, state.morphTo!);
    });

    if (morphButton) {
      const svg = morphButton.querySelector('svg');
      if (svg) {
        morphButton.addEventListener('click', () => {
          const isChecked = svg.getAttribute('aria-checked') === 'true';
          svg.setAttribute('aria-checked', Boolean(!isChecked).toString());
        });
      }
    }

    if (morphPathButton) {
      const svg = morphPathButton.querySelector('svg');
      if (svg) {
        morphPathButton.addEventListener('click', () => {
          const isChecked = svg.getAttribute('aria-checked') === 'true';
          svg.setAttribute('aria-checked', Boolean(!isChecked).toString());
        });
      }
    }

    inputContainer.setAttribute('data-initialized', 'true');
  }

  setupContainer();
  document.addEventListener('astro:after-swap', setupContainer);
</script>
