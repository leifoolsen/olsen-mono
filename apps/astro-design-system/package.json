{
  "name": "astro-design-system",
  "version": "0.0.19",
  "private": true,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "author": "Leif Olsen",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/olsen-mono/olsen-mono.git",
    "directory": "apps/astro-design-system"
  },
  "bugs": {
    "url": "https://github.com/olsen-mono/olsen-mono/issues"
  },
  "homepage": "https://github.com/olsen-mono/olsen-mono#readme",
  "scripts": {
    "compile": "pnpm run css-to-dts && astro build",
    "css-to-dts": "css-to-dts src --camelCase",
    "dev": "astro dev",
    "lint": "biome check . --no-errors-on-unmatched && prettier --no-error-on-unmatched-pattern --ignore-path ../../.prettierignore --check \"*.+(astro|md|mdx)\"",
    "preview": "astro preview",
    "typecheck": "astro check",
    "watch-css": "css-to-dts src --camelCase --watch"
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "@olsen-mono/astro-forms": "workspace:*",
    "@olsen-mono/astro-svg": "workspace:*",
    "@olsen-mono/core-utils": "workspace:*",
    "@olsen-mono/css-foundation": "workspace:*",
    "astro": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@olsen-mono/css-to-dts": "workspace:*"
  }
}
