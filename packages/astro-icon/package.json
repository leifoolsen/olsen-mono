{
  "name": "@olsen-mono/astro-icon",
  "description": "Astro icon component and icon factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "default": "./dist/index.mjs"
    },
    "./icon.astro": "./src/icon.astro",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "author": "leif.o.olsen@gmail.com",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/olsen-mono/olsen-mono.git",
    "directory": "packages/astro-icon"
  },
  "homepage": "https://github.com/olsen-mono/olsen-mono#readme",
  "scripts": {
    "clean": "shx rm -rf dist",
    "compile": "tsdown",
    "lint": "biome check . --no-errors-on-unmatched && prettier --no-error-on-unmatched-pattern --ignore-path ../../.prettierignore --check \"*.+(astro|md|mdx)\"",
    "typecheck": "astro check && tsc --noEmit"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  }
}
