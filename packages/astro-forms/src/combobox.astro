---
// packages/astro-forms/src/combobox.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import ClearIcon from "./clear-icon.astro";
import ErrorMessage from "./error-message.astro";
import FormDescription from "./form-description.astro";
import FormToolButton from "./form-tool-button.astro";
import InputControl from './input-control.astro';
import Label from './label.astro';
import Listbox from './listbox.astro';
import PickerIcon from "./picker-icon.astro";
import SearchIcon from "./search-icon.astro";
import './listbox.css';

type Props = HTMLAttributes<'input'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'top' | 'before';
  multiSelectable?: boolean;
};

const {
  'aria-controls': _ariaControls,
  'aria-describedby': ariaDescribedBy,
  'aria-expanded': ariaExpanded = 'false',
  'aria-haspopup': ariaHasPopup = 'true',
  'aria-invalid': ariaInvalid,
  autocomplete = 'off',
  class: className,
  id,
  invalid,
  label,
  labelPosition = 'top',
  multiSelectable = false,
  readonly,
  role = 'combobox',
  type = readonly ? 'text' : 'search',
  ...rest
} = Astro.props;

const ALLOWED_SLOTS = ['label', 'options', 'description', 'error-message'] as const;
assertValidSlots(Astro.slots, ALLOWED_SLOTS, 'Combobox');

const inputId = `${id}-input`;
const hasDescriptionSlot = Astro.slots.has('description');
const descriptionId = hasDescriptionSlot ? `${id}-description` : undefined;
const hasOptionsSlot = Astro.slots.has('options');
const resultsPopoverId = `${id}-results-popover`;
const uniqueAnchorName = `--anchor-list-${id}`;
const hasLabel = !!label || Astro.slots.has('label');
const hasErrorMessage = (invalid ?? ariaInvalid) && Astro.slots.has('error-message');
const errorId = hasErrorMessage ? `${id}-error` : undefined;
---

<ui-combobox class:list={['form-input-group', `layout-${labelPosition}`, className]} id={id}>
  {hasLabel && <Label for={inputId}>{label ? label : <slot name="label" />}</Label>}

  <InputControl class="combobox-control" style={`anchor-name: ${uniqueAnchorName};`}>
    <input
      aria-controls={resultsPopoverId}
      aria-describedby={descriptionId ?? ariaDescribedBy ?? undefined}
      aria-expanded={ariaExpanded}
      aria-haspopup={ariaHasPopup}
      aria-invalid={invalid ?? ariaInvalid ?? undefined}
      autocomplete={autocomplete}
      class:list={['form-text-input', 'combobox-input']}
      data-combobox-input
      id={inputId}
      readonly={readonly}
      role={role}
      type={type}
      {...rest}
    />

    {type === 'search' && <SearchIcon />}

    {type === 'text' && <PickerIcon />}

    <FormToolButton
      aria-label="Clear value"
      class="form-clear-icon"
    >
      <ClearIcon />
    </FormToolButton>

    {hasDescriptionSlot && (
      <FormDescription descriptionId={descriptionId!}>
        <slot name="description" />
      </FormDescription>
    )}
  </InputControl>

  {hasErrorMessage && (
    <ErrorMessage id={errorId}>
      <slot name="error-message" />
    </ErrorMessage>
  )}

  {hasOptionsSlot && (
    <div
      class="combobox-results-popover"
      data-combobox-popover
      id={resultsPopoverId}
      popover="auto"
      style={`position-anchor: ${uniqueAnchorName};`}
    >
      <Listbox id={`${id}-listbox`} multiSelectable={multiSelectable} data-combobox-listbox bordered showMarker>
        <slot name="options" />
      </Listbox>
    </div>
  )}
</ui-combobox>

<script>
  import { match } from '@olsen-mono/core-utils';
  import type { ComboboxChangeEventDetail, ListboxChangeEventDetail } from './types';

  class UIComboboxElement extends HTMLElement {
    private input!: HTMLInputElement;
    private popoverEl!: HTMLElement;
    private listbox!: HTMLElementTagNameMap['ui-listbox'];
    private isMultiSelectable = false;

    /* connectedCallback() fires when the element is inserted into the DOM */
    connectedCallback() {
      const foundInput = this.querySelector('[data-combobox-input]');
      const foundPopover = this.querySelector('[data-combobox-popover]');
      const foundListbox = this.querySelector('ui-listbox');

      if (
        !(foundInput instanceof HTMLInputElement) ||
        !(foundPopover instanceof HTMLElement) ||
        !(foundListbox instanceof HTMLElement)
      ) {
        match<boolean, void>()
          .on(!foundInput, () => {
            console.warn('[ui-combobox] Could not find input element with data-combobox-input');
          })
          .on(!foundPopover, () => {
            console.warn('[ui-combobox] Could not find element with data-combobox-popover');
          })
          .on(!foundListbox, () => {
            console.warn('[ui-combobox] Could not find ui-listbox Web Component');
          });

        return;
      }

      this.input = foundInput;
      this.popoverEl = foundPopover;
      this.listbox = foundListbox as HTMLElementTagNameMap['ui-listbox'];
      this.isMultiSelectable = this.listbox.getAttribute('aria-multiselectable') === 'true';

      this.setupIcons();
      this.setupEventListeners();
      this.syncInputValue();
    }

    private syncInputValue() {
      const selectedOptions = Array.from(this.listbox.querySelectorAll('[role="option"][aria-selected="true"]'));

      const data = selectedOptions.map((opt) => ({
        id: opt.id,
        name: opt.getAttribute('data-name') ?? '',
        value: opt.getAttribute('data-value') ?? '',
        text: opt instanceof HTMLElement ? opt.innerText : '',
      }));

      if (this.isMultiSelectable) {
        this.input.value = data.map((item) => item.text).join(', ');
        this.input.setAttribute('data-value', data.map((item) => item.value).join(', '));
      } else if (data[0]) {
        this.input.value = data[0].text;
        this.input.setAttribute('data-value', data[0].value);
      } else {
        this.input.value = '';
        this.input.setAttribute('data-value', '');
      }
    }

    private setupIcons() {
      const searchIcon = this.querySelector('.search-icon, .chevron-icon');
      const clearIcon = this.querySelector('.clear-icon');
      const infoIcon = this.querySelector('.info-icon');

      searchIcon?.addEventListener('click', () => {
        this.input.focus();
        this.input.click();
      });

      clearIcon?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        this.input.value = '';
        this.input.setAttribute('data-value', '');

        this.listbox.deselectAll();
        this.listbox.filter('');

        this.input.focus();
      });

      infoIcon?.addEventListener('click', () => {
        if (!this.input.disabled) {
          this.input.focus();
        }
      });
    }

    private setupEventListeners() {
      // --- Listbox Events ---
      this.listbox.addEventListener('keydown', (e: KeyboardEvent) => {
        match(e)
          .on(
            (e) => e.key === 'Escape',
            () => {
              e.preventDefault();
              this.closePopover();
            },
          )
          .on(
            (e) => e.key === ' ' || e.key === 'Enter',
            () => {
              e.preventDefault();
              if (!this.isMultiSelectable) {
                this.closePopover();
              }
            },
          );
      });

      this.listbox.addEventListener('blur', () => {
        this.listbox.filterDebounced.flush();
        this.closePopover();
      });

      this.listbox.addEventListener('click', () => {
        if (!this.isMultiSelectable) {
          this.closePopover();
        }
      });

      this.listbox.addEventListener('listbox-change', (e: Event) => {
        e.stopPropagation();
        const customEvent = e as CustomEvent<ListboxChangeEventDetail>;
        const data = customEvent.detail;

        if (Array.isArray(data)) {
          this.input.value = data.map((item) => item.text).join(', ');
          this.input.setAttribute('data-value', data.map((item) => item.value).join(', '));
        } else if (data) {
          this.input.value = data.text;
          this.input.setAttribute('data-value', data.value);
        } else {
          this.input.value = '';
          this.input.setAttribute('data-value', '');
        }

        this.dispatchEvent(
          new CustomEvent('combobox-change', {
            bubbles: true,
            detail: data,
          }),
        );

        if (!this.isMultiSelectable && data) {
          this.closePopover();
        }
      });

      // --- Input Events ---
      this.input.addEventListener('blur', () => {
        this.listbox.filterDebounced.flush();
      });

      this.input.addEventListener('click', () => {
        if (this.input.getAttribute('aria-expanded') !== 'true') {
          this.openPopover();
        } else {
          this.closePopover();
        }
      });

      this.input.addEventListener('input', () => {
        this.openPopover();

        if (this.input.value.trim() === '') {
          this.listbox.filterDebounced.cancel();
          this.listbox.filter('');
        } else {
          this.listbox.filterDebounced(this.input.value);
        }
      });

      this.input.addEventListener('keydown', (e: KeyboardEvent) => {
        match(e)
          .on(
            (e) => e.key === 'ArrowDown' || e.key === 'ArrowUp',
            (e) => {
              e.preventDefault();
              this.openPopover();
              this.listbox.focus();
            },
          )
          .on(
            (e) => e.key === 'Escape',
            () => {
              e.preventDefault();
              this.closePopover();
            },
          )
          .on(
            (e) => e.key === 'Tab',
            () => {
              this.closePopover();
            },
          );
      });
    }

    private openPopover() {
      this.popoverEl.showPopover();
      this.input.setAttribute('aria-expanded', 'true');
    }

    private closePopover() {
      this.popoverEl.hidePopover();
      this.input.setAttribute('aria-expanded', 'false');
      this.input.focus();
    }
  }

  if (!customElements.get('ui-combobox')) {
    customElements.define('ui-combobox', UIComboboxElement);
  }

  declare global {
    interface HTMLElementTagNameMap {
      'ui-combobox': UIComboboxElement;
    }
    interface HTMLElementEventMap {
      'combobox-change': CustomEvent<ComboboxChangeEventDetail>;
    }
  }
</script>
