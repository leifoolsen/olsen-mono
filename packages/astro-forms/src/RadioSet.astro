---
// packages/astro-forms/src/RadioSet.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import ErrorMessage from './ErrorMessage.astro';
import LegendLabel from './LegendLabel.astro';
import './forms.css';

type Props = HTMLAttributes<'fieldset'> & {
  id: string;
  invalid?: boolean;
  name: string;
  layout?: 'stack' | 'inline';
  legend?: string;
  legendPosition?: 'top' | 'before';
  required?: boolean;
  value?: string;
};

const {
  'aria-invalid': ariaInvalid,
  'aria-required': ariaRequired,
  class: className,
  id,
  invalid,
  name,
  legend,
  legendPosition = 'top',
  layout = 'stack',
  required,
  value,
  ...rest
} = Astro.props;

assertValidSlots(Astro.slots, ['error-message', 'legend'], 'RadioGroup');

const hasLegend = !!legend || Astro.slots.has('legend');
const hasErrorMessage = (invalid ?? ariaInvalid) && Astro.slots.has('error-message');

let legendContent = '';
if (!legend && Astro.slots.has('legend')) {
  legendContent = await Astro.slots.render('label');
}
---

<fieldset
  aria-invalid={invalid ?? ariaInvalid ?? undefined}
  aria-required={required ?? ariaRequired ?? undefined}
  data-radio-set
  id={id}
  class:list={['form-radio-set', `form-legend-${legendPosition}`, className]}
  aria-describedby={hasErrorMessage ? `${id}-error` : undefined}
  role="radiogroup"
  {...rest}
>
  {legendPosition === 'before' ? (
    <div class="form-radio-set-inline-wrapper">
      {hasLegend && !!legend ? (
        <LegendLabel>{legend}</LegendLabel>
      ) : (
        legendContent && <Fragment set:html={legendContent} />
      )}
      <div
        class:list={['form-radio-set-options', `layout-${layout}`]}
        data-group-id={id}
        data-group-name={name}
        data-group-value={value}
      >
        <slot />
      </div>
    </div>
  ) : (
    <>
      {hasLegend && !!legend ? (
        <LegendLabel>{legend}</LegendLabel>
      ) : (
        legendContent && <Fragment set:html={legendContent} />
      )}
      <div
        class:list={['form-radio-set-options', `layout-${layout}`]}
        data-group-id={id}
        data-group-name={name}
        data-group-value={value}
      >
        <slot />
      </div>
    </>
  )}

  {hasErrorMessage && (
    <ErrorMessage id={`${id}-error`} style="display: block;">
      <slot name="error-message" />
    </ErrorMessage>
  )}
</fieldset>

<script>
  function setupRadioSets() {
    const radioSets = document.querySelectorAll('[data-radio-set] ');

    for (const radioSet of radioSets) {
      if (!(radioSet instanceof HTMLFieldSetElement)) continue;

      const optionsContainer = radioSet.querySelector('.form-radio-set-options');
      if (!optionsContainer) continue;

      const groupId = radioSet.id;
      const groupName = optionsContainer.getAttribute('data-group-name');
      const groupValue = optionsContainer.getAttribute('data-group-value');
      const radioButtons = optionsContainer.querySelectorAll('input[type="radio"]');

      for (const radioButton of radioButtons) {
        if (!(radioButton instanceof HTMLInputElement)) continue;

        if (groupName) radioButton.name = groupName;

        if (groupId && !radioButton.id) {
          const cleanValue = radioButton.value.replace(/[^a-zA-Z0-9-_]/g, '');
          radioButton.id = `${groupId}-${cleanValue}`;
        }

        const wrapper = radioButton.closest('.form-input-group');
        if (wrapper) {
          const label = wrapper.querySelector('label');
          if (label) {
            label.setAttribute('for', radioButton.id);
          }
        }

        if (groupValue && radioButton.value === groupValue) {
          radioButton.checked = true;
        }
      }

      radioSet.setAttribute('data-initialized', 'true');
    }
  }

  setupRadioSets();
  document.addEventListener('astro:after-swap', setupRadioSets);
</script>
