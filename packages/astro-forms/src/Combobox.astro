---
// packages/astro-forms/src/Combobox.astro
import { chevronPointingDownLines, xLines } from '@olsen-mono/astro-svg';
import MorphLinesIcon from '@olsen-mono/astro-svg/MorphLinesIcon.astro';
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import ErrorMessage from './ErrorMessage.astro';
import FormDescription from './FormDescription.astro';
import FormToolButton from './FormToolButton.astro';
import InputControl from './InputControl.astro';
import InputGroup from './InputGroup.astro';
import Label from './Label.astro';
import SearchIcon from './SearchIcon.astro';
import './listbox.css';
import { injectForAttribute } from './utils.ts';

type Props = HTMLAttributes<'input'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'top' | 'before';
};

const {
  'aria-controls': _ariaControls,
  'aria-describedby': ariaDescribedBy,
  'aria-expanded': ariaExpanded = 'false',
  'aria-invalid': ariaInvalid,
  'aria-multiselectable': _ariaMultiSelectable,
  autocomplete = 'off',
  class: className,
  id,
  invalid,
  label,
  labelPosition = 'top',
  readonly,
  role = 'combobox',
  type = readonly ? 'text' : 'search',
  ...rest
} = Astro.props;

assertValidSlots(Astro.slots, ['label', 'options', 'description', 'error-message'], 'Combobox');

const hasLabel = !!label || Astro.slots.has('label');
const errorId = (invalid ?? ariaInvalid) && Astro.slots.has('error-message') ? `${id}-error` : undefined;
const descriptionId = Astro.slots.has('description') ? `${id}-description` : undefined;
const describedByList = [errorId, descriptionId, ariaDescribedBy].filter(Boolean).join(' ');
const hasOptionsSlot = Astro.slots.has('options');
const resultsPopoverId = `${id}-results-popover`;
const uniqueAnchorName = `--anchor-list-${id}`;

let labelContent = '';
if (!label && Astro.slots.has('label')) {
  const slotContent = await Astro.slots.render('label');
  labelContent = injectForAttribute(slotContent, id);
}
---

<InputGroup layout={labelPosition} class={className} data-combobox>
  {hasLabel && !!label ? <Label for={id}>{label}</Label> : labelContent && <Fragment set:html={labelContent} />}

  <InputControl class="combobox-control" style={`anchor-name: ${uniqueAnchorName};`}>
    <input
      aria-controls={resultsPopoverId}
      aria-describedby={describedByList ?? undefined}
      aria-expanded={ariaExpanded}
      aria-invalid={invalid ?? ariaInvalid ?? undefined}
      aria-multiselectable="false"
      autocomplete={autocomplete}
      class:list={['form-text-input', 'combobox-input']}
      data-combobox-input
      id={id}
      readonly={readonly}
      role={role}
      type={type}
      {...rest}
    />

    {type === 'search' && <SearchIcon data-search />}

    {type === 'text' && (
      <MorphLinesIcon
        class="form-picker-icon"
        data-picker
        fromLines={chevronPointingDownLines}
        toLines={chevronPointingDownLines}
        size={1.2}
      />
    )}

    <FormToolButton aria-label="Clear value" class="form-clear-icon" data-clear>
      <MorphLinesIcon fromLines={xLines} toLines={xLines} />
    </FormToolButton>

    {descriptionId && (
      <FormDescription descriptionId={descriptionId!}>
        <slot name="description" />
      </FormDescription>
    )}
  </InputControl>

  {errorId && (
    <ErrorMessage id={errorId}>
      <slot name="error-message" />
    </ErrorMessage>
  )}

  {hasOptionsSlot && (
    <div
      class="combobox-results-popover"
      data-combobox-popover
      id={resultsPopoverId}
      popover="auto"
      style={`position-anchor: ${uniqueAnchorName};`}
    >
      <slot name="options" />
    </div>
  )}
</InputGroup>

<script>
  import { createCombobox } from './combobox';

  const setupComboboxes = () => {
    const inputs = document.querySelectorAll<HTMLInputElement>('[data-combobox-input]');

    for (const input of inputs) {
      if (!(input instanceof HTMLInputElement) || input.hasAttribute('data-initialized')) continue;
      input.setAttribute('data-initialized', 'true');

      createCombobox(input);
    }
  };

  setupComboboxes();
  document.addEventListener('astro:after-swap', setupComboboxes);
</script>
