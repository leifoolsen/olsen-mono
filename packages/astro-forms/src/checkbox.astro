---
// src/components/form-element/radio-button.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import InputGroup from './input-group.astro';
import Label from './label.astro';
import './forms.css';

type Props = HTMLAttributes<'input'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'after' | 'before';
};

const {
  class: className,
  id,
  label,
  labelPosition = 'after',
  type = 'checkbox',
  'aria-invalid': ariaInvalid,
  invalid,
  ...rest
} = Astro.props;

assertValidSlots(Astro.slots, ['label'], 'RadioButton');

const hasLabel = !!label || Astro.slots.has('label');
---

<InputGroup layout={labelPosition} class={className}>
  <input
    aria-invalid={invalid ?? ariaInvalid ?? undefined}
    class="form-checkbox-input"
    id={id}
    type="checkbox"
    {...rest}
  />

  {hasLabel && <Label htmlFor={id}>{label ? label : <slot name="label" />}</Label>}
</InputGroup>
