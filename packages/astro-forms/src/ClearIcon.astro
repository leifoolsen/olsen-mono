---
// packages/astro-forms/src/ClearIcon.astro
import Svg from '@olsen-mono/astro-svg/Svg.astro';
import type { HTMLAttributes } from 'astro/types';
import clearSvg from './raw-svg/clear.svg?raw';

type Props = HTMLAttributes<'svg'> & {};

const { class: className, ...rest } = Astro.props;
---

<Svg class={className} name="clear" getSvgData={() => ({ rawSvg: clearSvg, scale: 1.2 })} {...rest} />
