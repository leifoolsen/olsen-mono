---
// packages/astro-forms/src/SearchIcon.astro
import Svg from '@olsen-mono/astro-svg/Svg.astro';
import type { HTMLAttributes } from 'astro/types';
import searchSvg from './raw-svg/search.svg?raw';

type Props = HTMLAttributes<'svg'> & {};

const { class: className, ...rest } = Astro.props;
---

<Svg
  class:list={['form-search-icon', className]}
  name="search"
  getSvgData={() => ({ rawSvg: searchSvg, scale: 1.2 })}
  style="transform: rotate(90deg)"
  {...rest}
/>
