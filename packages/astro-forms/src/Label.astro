---
// packages/astro-forms/src/Label.astro
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'label'> & {
  for?: string;
};

const { for: htmlFor, class: className, ...rest } = Astro.props;
const classes = ['form-label', className].filter(Boolean).join(' ');
---

<label for={htmlFor} class={classes} {...rest}>
  <slot />
</label>

<style>
  @layer components {
    .form-label {
      display: inline-flex;
      gap: var(--space-xs);
      flex-wrap: nowrap;
      user-select: none;
      line-height: 1;
      font-size: var(--font-size-m);
      font-weight: var(--font-weight-l);
      width: fit-content;
      white-space: nowrap;
      margin: 0;
      padding: 0;
      position: relative;
    }
  }
</style>
