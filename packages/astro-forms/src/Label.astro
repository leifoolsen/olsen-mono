---
// packages/astro-forms/src/Label.astro
import type { HTMLAttributes } from 'astro/types';
import './forms.css';

type Props = HTMLAttributes<'label'> & {
  for?: string;
};

const { for: htmlFor, class: className, ...rest } = Astro.props;
const classes = ['form-label', className].filter(Boolean).join(' ');
---

<!-- biome-ignore lint/a11y/noLabelWithoutControl: This is correct for a component -->
<label for={htmlFor} class={classes} {...rest}>
  <slot />
</label>
