---
// packages/astro-forms/src/select-input.astro
// import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import ErrorMessage from './error-message.astro';
import FieldHelp from './field-help.astro';
import InputControl from './input-control.astro';
import InputGroup from './input-group.astro';
import Label from './label.astro';

type Props = HTMLAttributes<'select'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'top' | 'before';
};

const {
  'aria-describedby': ariaDescribedBy,
  'aria-invalid': ariaInvalid,
  class: className,
  id,
  invalid,
  label,
  labelPosition = 'top',
  ...rest
} = Astro.props;

// assertValidSlots(Astro.slots, ['description', 'error-message', 'label'], 'SelectField');

const hasLabel = !!label || Astro.slots.has('label');
const hasErrorMessage = (invalid ?? ariaInvalid) && Astro.slots.has('error-message');
const hasDescriptionSlot = Astro.slots.has('description');
const descriptionId = hasDescriptionSlot ? `${id}-description` : undefined;
const errorId = hasErrorMessage ? `${id}-error` : undefined;
const describedByList = [descriptionId, ariaDescribedBy].filter(Boolean).join(' ');
---

<InputGroup layout="top">
  {hasLabel && <Label for={id}>{label ? label : <slot name="label" />}</Label>}

  <InputControl>
    <select
      aria-invalid={invalid ?? undefined}
      aria-describedby={describedByList || undefined}
      class="form-select-input"
      data-select-input
      id={id}
      {...rest}
    >
      <slot />
    </select>

    <div class="chevron-icon" />

    <button
      aria-label="Clear value"
      class="clear-icon"
      tabindex="-1"
      type="button"
      style="
        align-content: center;
        aspect-ratio: 1;
        background: transparent;
        box-shadow: none;
        border: none;
        cursor: pointer;
        display: inline-grid;
        height: 1em;
        outline: none;
        padding: 0;
        place-items: center;
        user-select: none;
      "
    >
      x
    </button>

    {hasDescriptionSlot && (
      <FieldHelp id={descriptionId!}>
        <slot name="description" />
      </FieldHelp>
    )}
  </InputControl>

  {hasErrorMessage && (
    <ErrorMessage id={errorId}>
      <slot name="error-message" />
    </ErrorMessage>
  )}
</InputGroup>

<script>
  function setupSelectFields() {
    const inputs = document.querySelectorAll('[data-select-input]');

    for (const input of inputs) {
      if (!(input instanceof HTMLSelectElement) || input.hasAttribute('data-initialized')) continue;
      input.setAttribute('data-initialized', 'true');

      const wrapper = input.closest('.form-input-control');
      if (!wrapper) continue;

      const chevronIcon = wrapper.querySelector<HTMLDivElement>('.chevron-icon');
      const clearButton = wrapper.querySelector<HTMLButtonElement>('.clear-icon');
      const infoIcon = wrapper.querySelector<HTMLButtonElement>('.info-icon');

      if (chevronIcon) {
        chevronIcon.addEventListener('click', () => {
          if (typeof input.showPicker === 'function') {
            input.showPicker();
          }
          input.focus();
        });
      }

      if (clearButton) {
        clearButton.addEventListener('click', () => {
          input.value = '';
          input.focus();
          input.dispatchEvent(new Event('input', { bubbles: true }));
        });
      }

      if (infoIcon) {
        infoIcon.addEventListener('click', () => {
          if (!input.disabled) {
            input.focus();
          } else {
            infoIcon.disabled = true;
          }
        });
      }
    }
  }

  setupSelectFields();
  document.addEventListener('astro:after-swap', setupSelectFields);
</script>
