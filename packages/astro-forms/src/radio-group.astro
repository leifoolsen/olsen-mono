---
// packages/astro-forms/src/RadioGroup.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import ErrorMessage from './error-message.astro';
import './forms.css';

type Props = HTMLAttributes<'fieldset'> & {
  id: string;
  name: string;
  value?: string;
  label?: string;
  layout?: 'stack' | 'inline';
};

const { id, name, value, label, layout = 'stack', class: className, ...rest } = Astro.props;

assertValidSlots(Astro.slots, ['error-message'], 'RadioGroup');
const hasErrorMessageSlot = Astro.slots.has('error-message');
---

<fieldset
  id={id}
  class:list={['form-radio-group', className]}
  aria-describedby={hasErrorMessageSlot ? `${id}-error` : undefined}
  role="radiogroup"
  {...rest}
>
  {label && (
    <legend id={`${id}-legend`} class="form-label">
      {label}
    </legend>
  )}

  <div
    class:list={['form-radio-group-options', `layout-${layout}`]}
    data-group-id={id}
    data-group-name={name}
    data-group-value={value}
  >
    <slot />
  </div>

  {hasErrorMessageSlot && (
    <ErrorMessage id={`${id}-error`}>
      <slot name="error-message" />
    </ErrorMessage>
  )}
</fieldset>

<script>
  function enrichRadioGroups() {
    const containers = document.querySelectorAll('.form-radio-group-options');

    for (const container of containers) {
      const groupId = container.getAttribute('data-group-id');
      const groupName = container.getAttribute('data-group-name');
      const groupValue = container.getAttribute('data-group-value');

      const inputs = container.querySelectorAll('input[type="radio"]');

      for (const input of inputs) {
        if (!(input instanceof HTMLInputElement)) continue;

        // 1. Name arves og overskriver alt
        if (groupName) input.name = groupName;

        // 2. Regn ut ID hvis den mangler eller er standard autogenerert
        if (groupId && (!input.id || input.id.startsWith('form-elements'))) {
          const cleanValue = input.value.replace(/[^a-zA-Z0-9-_]/g, '');
          input.id = `${groupId}-${cleanValue}`;

          /*
            NATIV OG SKUDDSIKKER KOBLING:
            Vi henter forelderen til input-feltet (som er din InputGroup-div).
            Deretter finner vi den første <label>-taggen som ligger der inne.
          */
          const wrapper = input.closest('div');
          if (wrapper) {
            const label = wrapper.querySelector('label');
            if (label) {
              // Tvinger alltid for-attributten til å matche input-ID-en
              label.setAttribute('for', input.id);
            }
          }
        }

        // 3. Sett initiell checked-tilstand basert på gruppens verdi
        if (groupValue && input.value === groupValue) {
          input.checked = true;
        }
      }
    }
  }

  // Kjør JIT
  enrichRadioGroups();
  document.addEventListener('astro:after-swap', enrichRadioGroups);
</script>

