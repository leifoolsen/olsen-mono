---
// packages/astro-forms/src/RangeInput.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import FormDescription from './FormDescription.astro';
import InputControl from './InputControl.astro';
import InputGroup from './InputGroup.astro';
import Label from './Label.astro';

type Props = HTMLAttributes<'input'> & {
  id: string;
  label?: string;
  labelPosition?: 'top' | 'before';
  min: number;
  max: number;
  step: number;
};

const {
  'aria-describedby': ariaDescribedBy,
  class: className,
  id,
  label,
  labelPosition = 'top',
  min,
  max,
  name,
  step = 1,
  type,
  value,
  ...rest
} = Astro.props;

assertValidSlots(Astro.slots, ['description', 'label'], 'RangeInput');

const hasLabel = !!label || Astro.slots.has('label');
const hasDescriptionSlot = Astro.slots.has('description');
const descriptionId = hasDescriptionSlot ? `${id}-description` : undefined;
const describedByList = [descriptionId, ariaDescribedBy].filter(Boolean).join(' ');
const numberInputId = `${id}-number`;
---

<InputGroup layout={labelPosition} class={className}>
  {hasLabel && <Label for={id}>{label ? label : <slot name="label" />}</Label>}

  <InputControl>
    <input
      aria-describedby={describedByList}
      class="form-range-input"
      type="range"
      id={id}
      min={min}
      max={max}
      name={name}
      step={step}
      value={value}
      oninput={`document.getElementById('${numberInputId}').value = this.value`}
      {...rest}
    />

    <input
      aria-describedby={describedByList}
      aria-label="Range input value"
      class="form-text-input form-range-number-input"
      type="number"
      id={numberInputId}
      min={min}
      max={max}
      name={name ? `${name}-number` : undefined}
      step={step}
      value={value}
      oninput={`document.getElementById('${id}').value = this.value`}
      {...rest}
    />

    {descriptionId && (
      <FormDescription descriptionId={descriptionId}>
        <slot name="description" />
      </FormDescription>
    )}
  </InputControl>
</InputGroup>

<style>
  @import './forms-tokens.css' layer(components);

  @layer components {
    .form-range-input[type='range'] {
      flex: 100%;
    }

    /* Webkit */
    .form-range-input[type='range']::-webkit-slider-runnable-track {
      width: 100%;
      height: var(--form-range-track-height);
      background-color: oklch(from var(--swatch-color) calc(l + 0.04) c h / 95%);
      border: 1px solid var(--border-color);
      border-radius: calc(infinity * 1px);
      transition: border-color 0.2s;
    }

    .form-range-input[type='range']::-webkit-slider-thumb {
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      margin-top: calc((var(--form-slider-thumb-height) - var(--form-range-track-height) + 1px) / -2);
      height: var(--form-slider-thumb-height);
      width: var(--form-slider-thumb-height);
      border-radius: 50%;
      background-color: oklch(from var(--accent-color) l c h / 95%);
      border: 1px solid var(--accent-color);
      transition:
        transform 0.1s ease,
        background-color 0.2s;
    }

    @media (hover: hover) {
      .form-range-input[type='range']::-webkit-slider-thumb:hover {
        transform: scale(1.15);
      }
    }

    /* Mozilla */
    .form-range-input[type='range']::-moz-range-track {
      width: 100%;
      height: var(--form-range-track-height);
      background-color: oklch(from var(--swatch-color) calc(l + 0.04) c h / 95%);
      border: 1px solid var(--border-color);
      border-radius: calc(infinity * 1px);
    }

    .form-range-input[type='range']::-moz-range-thumb {
      height: var(--form-slider-thumb-height);
      width: var(--form-slider-thumb-height);
      border: 1px solid var(--border-color);
      border-radius: 50%;
      background-color: oklch(from var(--accent-color) l c h / 95%);
      transition: transform 0.1s ease;
    }

    @media (hover: hover) {
      .form-range-input[type='range']::-moz-range-thumb:hover {
        transform: scale(1.15);
      }
    }

    [type='number'].form-range-number-input {
      background-color: transparent;
      width: 12ch;
      text-align: center;
      appearance: textfield;
      -webkit-appearance: textfield;
      -moz-appearance: textfield;

      &::-webkit-outer-spin-button,
      &::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }
    }
  }
</style>
