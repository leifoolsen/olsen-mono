---
// packages/astro-forms/src/TextAreaInput.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import ErrorMessage from './ErrorMessage.astro';
import InputControl from './InputControl.astro';
import InputGroup from './InputGroup.astro';
import Label from './Label.astro';
import { injectForAttribute } from './utils.ts';
import './forms.css';

type Props = HTMLAttributes<'textarea'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'top' | 'before';
  value?: string;
};

const {
  'aria-describedby': ariaDescribedBy,
  'aria-invalid': ariaInvalid,
  class: className,
  id,
  invalid,
  label,
  labelPosition = 'top',
  value,
  ...rest
} = Astro.props;

assertValidSlots(Astro.slots, ['error-message', 'label'], 'TextArea');

const hasLabel = !!label || Astro.slots.has('label');
const hasErrorMessage = (invalid ?? ariaInvalid) && Astro.slots.has('error-message');
const errorId = hasErrorMessage ? `${id}-error` : undefined;
const textAreaValue = value ?? ((Astro.slots.has('default') ? await Astro.slots.render('default') : '') as string); // .trim();
const describedByList = [errorId, ariaDescribedBy].filter(Boolean).join(' ');

let labelContent = '';
if (!label && Astro.slots.has('label')) {
  const slotContent = await Astro.slots.render('label');
  labelContent = injectForAttribute(slotContent, id);
}
---

<InputGroup layout={labelPosition} class={className}>
  {hasLabel && !!label ? <Label for={id}>{label}</Label> : labelContent && <Fragment set:html={labelContent} />}

  <InputControl>
    <textarea
      aria-describedby={describedByList || undefined}
      aria-invalid={invalid ?? ariaInvalid ?? undefined}
      class="form-textarea-input"
      id={id}
      {...rest}
    >{textAreaValue}</textarea>
  </InputControl>

  {hasErrorMessage && (
    <ErrorMessage id={errorId}>
      <slot name="error-message" />
    </ErrorMessage>
  )}
</InputGroup>
