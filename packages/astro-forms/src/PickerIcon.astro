---
import Svg from '@olsen-mono/astro-svg/Svg.astro';
import type { HTMLAttributes } from 'astro/types';
import arrowForwardSvg from './raw-svg/MaterialSymbolsArrowForwardIosRounded.svg?raw';

type Props = HTMLAttributes<'svg'> & {};

const { class: className, name = 'arrow-down', ...rest } = Astro.props;
---

<Svg
  class:list={['form-picker-icon', className]}
  name={name}
  getSvgData={(_name) => ({ rawSvg: arrowForwardSvg, scale: 1.1 })}
  style="transform: rotate(90deg)"
  {...rest}
/>
