---
// packages/astro-forms/src/label.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'label'> & {
  text?: string;
};

const { class: className, htmlFor, text, ...rest } = Astro.props;

assertValidSlots(Astro.slots, [], 'Label');
---

<label for={htmlFor} class={className} {...rest}>
  {text ? text : <slot />}
</label>
