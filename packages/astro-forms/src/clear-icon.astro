---
// packages/astro-forms/src/clear-icon.astro
import Svg from '@olsen-mono/astro-svg/Svg.astro';
import type { HTMLAttributes } from 'astro/types';
import clearSvg from './raw-svg/clear.svg?raw';

type Props = HTMLAttributes<'svg'> & {};

const { class: className, name = 'clear', ...rest } = Astro.props;
---

<Svg class={className} name={name} getSvgData={() => ({ rawSvg: clearSvg, scale: 1.1 })} {...rest} />
