---
import type { HTMLAttributes } from 'astro/types';
import InputControl from './InputControl.astro';
import InputGroup from './InputGroup.astro';
import Label from './Label.astro';
import './forms.css';

type Props = HTMLAttributes<'input'> & {
  id: string;
  label?: string;
  labelPosition?: 'after' | 'before';
};

const {
  class: className,
  id,
  label,
  labelPosition = 'after',
  role = 'switch',
  type = 'checkbox',
  ...rest
} = Astro.props;

const hasLabel = !!label || Astro.slots.has('label');
---

<InputGroup layout={labelPosition} class={className}>
  {hasLabel && <Label for={id}>{label ? label : <slot name="label" />}</Label>}

  <InputControl>
    <label role="checkbox" class="form-toggle-switch">
      <input class="form-toggle-switch-input" id={id} role={role} type={type} {...rest} />
    </label>
  </InputControl>
</InputGroup>
