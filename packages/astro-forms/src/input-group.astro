---
// packages/astro-forms/src/input-group.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import './forms.css';

type Props = HTMLAttributes<'div'> & {};

const { class: className, ...rest } = Astro.props;

assertValidSlots(Astro.slots, [], 'InputGroup');
---

<div class:list={['input-group', className]} {...rest}>
  <slot />
</div>
