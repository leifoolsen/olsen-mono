---
// packages/astro-forms/src/input-group.astro
// import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import ErrorMessage from './error-message.astro';
import './forms.css';

type Props = HTMLAttributes<'div'> & {
  layout?: 'top' | 'before' | 'after';
  invalid?: boolean;
};

const { class: className, id, invalid, layout = 'top', ...rest } = Astro.props;

// assertValidSlots(Astro.slots, [], 'InputGroup');
---

<div class:list={['form-input-group', `layout-${layout}`, className]} {...rest}>
  <slot />
</div>
