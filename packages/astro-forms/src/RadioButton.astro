---
// src/components/form-element/RadioButton.astro
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import InputControl from './InputControl.astro';
import InputGroup from './InputGroup.astro';
import Label from './Label.astro';
import './forms.css';

type Props = HTMLAttributes<'input'> & {
  id?: string;
  label?: string;
  labelPosition?: 'after' | 'before';
};

const { class: className, id, label, labelPosition = 'after', type = 'radio', ...rest } = Astro.props;

assertValidSlots(Astro.slots, ['label'], 'RadioButton');

const hasLabel = !!label || Astro.slots.has('label');
---

<InputGroup layout={labelPosition} class={className}>
  {hasLabel && <Label for={id}>{!!label ? label : <slot name="label" />}</Label>}

  <InputControl>
    <input type={type} class="form-radio-input" id={id} {...rest} />
  </InputControl>
</InputGroup>
