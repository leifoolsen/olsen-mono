---
// packages/astro-forms/src/TextInput.astro
import { xLines } from '@olsen-mono/astro-morph-icons';
import MorphLineIcon from '@olsen-mono/astro-morph-icons/MorphLineIcon.astro';
import { assertValidSlots } from '@olsen-mono/core-utils';
import type { HTMLAttributes } from 'astro/types';
import ErrorMessage from './ErrorMessage.astro';
import FormDescription from './FormDescription.astro';
import FormToolButton from './FormToolButton.astro';
import InputControl from './InputControl.astro';
import InputGroup from './InputGroup.astro';
import Label from './Label.astro';
import SearchIcon from './SearchIcon.astro';
import './forms.css';

type Props = HTMLAttributes<'input'> & {
  id: string;
  invalid?: boolean;
  label?: string;
  labelPosition?: 'top' | 'before';
};

const {
  'aria-describedby': ariaDescribedBy,
  'aria-invalid': ariaInvalid,
  class: className,
  id,
  invalid,
  label,
  labelPosition = 'top',
  type = 'text',
  ...rest
} = Astro.props;

assertValidSlots(Astro.slots, ['description', 'error-message', 'label'], 'TextInput');

const hasLabel = !!label || Astro.slots.has('label');
const hasErrorMessage = (invalid ?? ariaInvalid) && Astro.slots.has('error-message');
const errorId = hasErrorMessage ? `${id}-error` : undefined;
const hasDescriptionSlot = Astro.slots.has('description');
const descriptionId = hasDescriptionSlot ? `${id}-description` : undefined;
const describedByList = [descriptionId, ariaDescribedBy].filter(Boolean).join(' ');
---

<InputGroup layout={labelPosition} class={className}>
  {hasLabel && <Label for={id}>{label ? label : <slot name="label" />}</Label>}

  <InputControl>
    <input
      aria-describedby={describedByList ?? undefined}
      aria-invalid={invalid ?? ariaInvalid ?? undefined}
      class="form-text-input"
      data-text-input
      id={id}
      type={type}
      {...rest}
    />

    {type === 'search' && <SearchIcon data-search />}

    <FormToolButton aria-label="Clear value" class="form-clear-icon" data-clear>
      <MorphLineIcon fromLines={xLines} toLines={xLines} />
    </FormToolButton>

    {hasDescriptionSlot && (
      <FormDescription descriptionId={descriptionId!}>
        <slot name="description" />
      </FormDescription>
    )}
  </InputControl>

  {hasErrorMessage && (
    <ErrorMessage id={errorId}>
      <slot name="error-message" />
    </ErrorMessage>
  )}
</InputGroup>

<script>
  function setupInputFields() {
    const inputs = document.querySelectorAll('[data-text-input]');

    for (const input of inputs) {
      if (!(input instanceof HTMLInputElement) || input.hasAttribute('data-initialized')) continue;
      input.setAttribute('data-initialized', 'true');

      const wrapper = input.closest('.form-input-control');
      if (!wrapper) continue;

      const searchIcon = wrapper.querySelector('[data-search]');
      if (searchIcon) {
        searchIcon.addEventListener('click', () => input.focus());
      }

      const clearButton = wrapper.querySelector<HTMLButtonElement>('[data-clear]');
      if (clearButton) {
        clearButton.addEventListener('click', () => {
          input.value = '';
          input.focus();
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }
    }
  }

  setupInputFields();
  document.addEventListener('astro:after-swap', setupInputFields);
</script>
