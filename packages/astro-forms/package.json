{
  "name": "@olsen-mono/astro-forms",
  "description": "Astro form components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./forms.css": {
      "types": "./src/forms.css.d.ts",
      "default": "./src/forms.css"
    },
    "./InputGroup.astro": "./src/input-group.astro",
    "./Label.astro": "./src/label.astro",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "author": "leif.o.olsen@gmail.com",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/olsen-mono/olsen-mono.git",
    "directory": "packages/astro-forms"
  },
  "homepage": "https://github.com/olsen-mono/olsen-mono#readme",
  "scripts": {
    "compile": "pnpm run css-to-dts",
    "css-to-dts": "css-to-dts src --camelCase",
    "lint": "biome check . --no-errors-on-unmatched && prettier --no-error-on-unmatched-pattern --ignore-path ../../.prettierignore --check \"*.+(astro|md|mdx)\"",
    "typecheck": "astro check && tsc --noEmit"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "dependencies": {
    "@olsen-mono/core-utils": "workspace:*"
  },
  "devDependencies": {
    "@olsen-mono/astro-test-utils": "workspace:*",
    "@olsen-mono/css-to-dts": "workspace:*",
    "@types/node": "catalog:",
    "astro": "catalog:",
    "happy-dom": "catalog:"
  }
}
