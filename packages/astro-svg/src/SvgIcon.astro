---
// packages/astro-svg/src/SvgIcon.astro
import type { HTMLAttributes } from 'astro/types';
import { sanitizeSvg } from './svg-sanitizer.ts';
import type { GetSvgData } from './types.ts';

type Props = HTMLAttributes<'svg'> & {
  getSvgData: GetSvgData;
  size?: string | number | null;
};

const {
  'stroke-width': strokeWidth,
  class: className,
  getSvgData,
  height,
  name,
  size,
  style: userStyle,
  width,
  ...rest
} = Astro.props;

const { rawSvg, defaultSize } = getSvgData(name);

/** Formats size value. If the Value is a number, it is converted to an em unit. Otherwise, it is returned as is. */
const formatSize = (val: string | number | undefined | null, fallback: string | number): string | number => {
  if (val === undefined || val === null) return formatSize(fallback, 1);
  return typeof val === 'number' ? `${val}em` : val;
};

/**
 * Escapes attribute values for safe insertion into an HTML attribute context.
 * This preserves the original value but encodes characters that would break
 * attribute syntax or allow injection.
 */
const escapeAttribute = (value: unknown) =>
  String(value)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

const finalSize = size ?? defaultSize;
const finalWidth = formatSize(width ?? finalSize, 1);
const finalHeight = formatSize(height ?? finalSize, 1);
const finalStrokeWidth = formatSize(strokeWidth, '2');

const style =
  typeof userStyle === 'string'
    ? userStyle
    : Object.entries(userStyle ?? {})
        .map(([key, value]) => `${key}: ${value}; `)
        .join('');

const svgAttributes: Record<string, any> = { ...rest };

svgAttributes.class = className;
svgAttributes.style = `max-inline-size: unset; ${style}`.trimEnd();
svgAttributes.name = name;
svgAttributes.height = finalHeight;
svgAttributes.width = finalWidth;
svgAttributes['stroke-width'] = finalStrokeWidth;

// Accessibility: mirror the approach used in MorphLinesIcon — prefer an accessible name, but
// respect an explicit aria-hidden prop when provided.
const hasAccessibleName = rest['aria-label'] || rest['aria-labelledby'];
const explicitAriaHidden = rest['aria-hidden'] !== undefined;
const ariaHiddenFinal = explicitAriaHidden ? rest['aria-hidden'] : hasAccessibleName ? undefined : 'true';

if (hasAccessibleName) {
  svgAttributes.role = rest.role || 'img';
}

if (ariaHiddenFinal !== undefined) {
  svgAttributes['aria-hidden'] = ariaHiddenFinal;
}

// Apply the sanitizer before we mutate attributes and inject into the page.
const sanitizedRawSvg = sanitizeSvg(rawSvg);

/**
 * Removes width, height, and stroke-width attributes from the SVG tag.
 * stroke-width is also removed from child elements.
 */
const cleanedSvg = sanitizedRawSvg
  .replace(/(?<!-)\bwidth=["'][^"']*["']/gi, '')
  .replace(/(?<!-)\bheight=["'][^"']*["']/gi, '')
  .replace(/\bstroke-width=["'][^"']*["']/gi, '');

const attributesString = Object.entries(svgAttributes)
  .filter(([key, value]) => /^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/.test(key) && value != null)
  .map(([key, value]) => `${key}="${escapeAttribute(value)}"`)
  .join(' ');

const svgWithAttributes = cleanedSvg.replace(/<svg/i, `<svg ${attributesString}`.trim().replace(/\s+/g, ' '));
---

<Fragment set:html={svgWithAttributes} />
