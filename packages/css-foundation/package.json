{
  "name": "@olsen-mono/css-foundation",
  "description": "CSS Foundation",
  "version": "0.0.16",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./main.css": {
      "types": "./dist/main.css.d.ts",
      "development": "./src/main.css",
      "default": "./src/main.css"
    },
    "./colors.css": {
      "types": "./dist/colors.css.d.ts",
      "development": "./src/colors.css",
      "default": "./src/colors.css"
    },
    "./font-stacks.css": {
      "types": "./dist/font-stacks.css.d.ts",
      "development": "./src/font-stacks.css",
      "default": "./src/font-stacks.css"
    },
    "./reset.css": {
      "types": "./dist/reset.css.d.ts",
      "development": "./src/reset.css",
      "default": "./src/reset.css"
    },
    "./typesetting.css": {
      "types": "./dist/typesetting.css.d.ts",
      "development": "./src/typesetting.css",
      "default": "./src/typesetting.css"
    },
    "./typography.css": {
      "types": "./dist/typography.css.d.ts",
      "development": "./src/typography.css",
      "default": "./src/typography.css"
    },
    "./layouts.css": {
      "types": "./dist/layout.css.d.ts",
      "development": "./src/layouts.css",
      "default": "./src/layouts.css"
    },
    "./package.json": "./package.json"
  },
  "keywords": [],
  "author": "leif.o.olsen@gmail.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/olsen-mono/olsen-mono.git",
    "directory": "packages/css-foundation"
  },
  "bugs": {
    "url": "https://github.com/olsen-mono/olsen-mono/issues"
  },
  "homepage": "https://github.com/olsen-mono/olsen-mono#readme",
  "scripts": {
    "compile": "pnpm run css-to-dts",
    "css-to-dts": "css-to-dts src --camelCase --outDir dist",
    "lint": "biome check . --no-errors-on-unmatched && prettier --no-error-on-unmatched-pattern --ignore-path ../../.prettierignore --check \"*.+(astro|md|mdx)\"",
    "watch-css": "css-to-dts src --camelCase --watch"
  },
  "devDependencies": {
    "@olsen-mono/css-to-dts": "workspace:*"
  }
}
