{
  "name": "@olsen-mono/astro-morph-icons",
  "description": "Astro Morph Icons",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "development": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "default": "./dist/index.mjs"
    },
    "./MorphLinesIcon.astro": "./src/MorphLinesIcon.astro",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "author": "leif.o.olsen@gmail.com",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/olsen-mono/olsen-mono.git",
    "directory": "packages/astro-icons"
  },
  "homepage": "https://github.com/olsen-mono/olsen-mono#readme",
  "scripts": {
    "clean": "shx rm -rf dist",
    "compile": "tsdown",
    "lint": "biome check . --no-errors-on-unmatched && prettier --no-error-on-unmatched-pattern --ignore-path ../../.prettierignore --check \"*.+(astro|md|mdx)\"",
    "test": "vitest run",
    "typecheck": "astro check && tsc --noEmit"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "astro": "catalog:",
    "happy-dom": "catalog:"
  }
}
